/*---------------------------------------------------------------------------*\
  Predefined MIXTURE: dry atmospheric air.

  A mixture file is NOT a component -- it carries no properties of its own.
  It is an EXPANSION TABLE: when a thermoPackage lists `air` in its
  `components ( ... )`, the loader splices it open into its member
  components (which DO have curated .dat files) and seeds a feed stream's
  composition with the member mole fractions below.

  Glass-box: the splice is announced LOUDLY on stderr, e.g.
      [mixture] 'air' -> N2 (0.7808) + O2 (0.2095) + Ar (0.0093)

  Trace species (CO2 ~400 ppm, Ne, He, ...) are dropped; the three retained
  members carry > 99.9 % of dry air and the fractions are renormalised to 1.
\*---------------------------------------------------------------------------*/

mixture     air;

members
(
    { component N2;   x 0.7808; }      // nitrogen
    { component O2;   x 0.2095; }      // oxygen
    { component Ar;   x 0.0093; }      // argon
);

provenance
{
    origin   standard;
    note     "dry air, US Standard Atmosphere 1976 mole fractions (N2/O2/Ar; trace species omitted)";
}
/*---------------------------------------------------------------------------*\
  Predefined MIXTURE: humid (moist) atmospheric air.

  Dry-air members (N2/O2/Ar) PLUS water vapour at a stated mole fraction.
  Like air.dat this is an expansion table, not a component.

  Humidity assumption (documented, not hidden):
    x_H2O = 0.0230  corresponds to ~saturated air at 20 degC, 1 atm
    (P_sat,water(293.15 K) ~ 2.34 kPa ; x ~ P_sat / P_total ~ 2.34/101.3).
    The dry-air members are scaled by (1 - x_H2O) so the full set still
    sums to 1.0 after the loader's renormalisation.

  Member component for water is `water` (data/standards/components/water.dat).
\*---------------------------------------------------------------------------*/

mixture     airHumid;

members
(
    { component N2;     x 0.76284; }   // 0.7808 * (1 - 0.0230)
    { component O2;     x 0.20468; }   // 0.2095 * (1 - 0.0230)
    { component Ar;     x 0.00908; }   // 0.0093 * (1 - 0.0230)
    { component water;  x 0.02300; }   // ~saturated at 20 degC, 1 atm
);

provenance
{
    origin   standard;
    note     "moist air: US Std Atmosphere dry-air ratio scaled by (1-x_H2O), x_H2O=0.023 (~sat. at 20 degC, 1 atm)";
}
/*---------------------------------------------------------------------------*\
  Predefined MIXTURE: typical combustion flue gas.

  CO2 / H2O / N2 / O2 at a representative wet flue-gas composition for
  natural-gas (methane) combustion with modest excess air.  Like air.dat
  this is an expansion table, not a component.

  Composition assumption (documented):
    A natural-gas boiler running ~10-15 % excess air produces, on a WET
    basis, roughly:
       CO2  ~ 0.085      N2  ~ 0.71
       H2O  ~ 0.18       O2  ~ 0.025
    Values below are rounded to a clean, renormalisable set; the loader
    renormalises to exactly 1.0.  Argon (~0.9 % of the air) is folded into
    N2 here for a 4-species teaching mixture.

  Member component for water is `water` (data/standards/components/water.dat).
\*---------------------------------------------------------------------------*/

mixture     flueGas;

members
(
    { component CO2;    x 0.085; }      // combustion product
    { component water;  x 0.180; }      // combustion product (wet basis)
    { component N2;     x 0.710; }      // diluent from the air
    { component O2;     x 0.025; }      // residual excess-air oxygen
);

provenance
{
    origin   standard;
    note     "typical wet flue gas, natural-gas combustion ~10-15% excess air (CO2/H2O/N2/O2; Ar folded into N2)";
}
/*--------------------------------*- Choupo -*-----------------------*\
  Component: Carbon monoxide  (CO, CAS 630-08-0)
  Permanent gas at any process-relevant temperature.  Antoine and Vliq
  carried for schema compliance only; Tc=132.85 K means we never see
  a liquid in v0.15 process conditions.
  Sources: constants (Tc, Pc, omega, MW, Tb) cross-checked against the
  CoolProp 7.2.0 reference equation of state (MIT-licensed); ideal-gas
  formation properties (dHf_298, s_298) from NASA TM-4513 (McBride-
  Gordon-Reno 1993).
\*---------------------------------------------------------------------------*/

name        CO;
formula     CO;
CAS         630-08-0;

MW          28.010;       // kg/kmol
Tc          132.85;       // K
Pc          34.94;        // bar
omega       0.045;        // [-]
Tb          81.65;        // K
HvapTb      6042;         // J/mol
Vliq        3.55e-5;      // m^3/mol  (35.5 cm^3/mol at Tb)
VliqT       81.65;       // K -- the temperature Vliq belongs to: the record's own statement ("at Tb")
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 6402;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]
diffusionVolume  18.0;          // Fuller diffusion volume [-]

standardThermochemistry
{
    dHf_298   -110530.0;          // J/mol  -- ideal-gas reference
    s_298     197.660;            // J/(mol·K)  -- third-law absolute
}

vaporPressure
{
    model         Antoine;
    coefficients  (3.81912   291.743   -5.151);
    Trange        (68  132);
}

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol·K)] = a0 + a1*T + a2*T^2 + a3*T^3  (ideal-gas Cp
    // polynomial -- individual literature value, primary re-citation pending)
    coefficients  (30.87   -1.285e-2   2.789e-5   -1.272e-8);
    Trange        (250  1500);
}

// Friendly-name aliases (resolved to this file via the generated ALIASES index).
aliases ( carbonMonoxide );

cosmo
{
    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "VT-2005 sigma-profile database (Mullins et al., Ind. Eng. Chem. Res. 45 (2006) 4389; DFT-COSMO), file VT2005-0387-PROF.txt bundled in usnistgov/COSMOSAC; CAS 630-08-0";
        licence     externalRestricted;   // VT-2005: redistribution NOT confirmed -- values NOT shipped
        installed   false;                 // install your own copy: bin/choupo-import-cosmo (-> data/local/cosmo/VT2005/)
    }
}
