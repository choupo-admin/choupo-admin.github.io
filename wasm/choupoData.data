// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (1 CH3 + 1 CH2 + 1 CH3CO), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   3.2479;
    q   2.8760;
}

groups
{
    unifac ( { group CH3; count 1; } { group CH2; count 1; } { group CH3CO; count 1; } );
    unifacDortmund ( { group CH3; count 1; } { group CH2; count 1; } { group CH3CO; count 1; } );   // C408 (c): P 2-butanone, Table III p. 182-183
}
solubilityParameter 18880;   // Pa^0.5  [ANCHOR, ChemSep v8.3 -- checked against, never used]

