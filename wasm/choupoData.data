}

Vliq        0.000151847;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      42703.9;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (110.94  -562.53  6.111244721  0.00027207  -1.0669e-07);
    Trange        (200  1500);
}

liquidHeatCapacity
{
