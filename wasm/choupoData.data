}

//  HANSEN solubility-parameter triple (DEV.md 4c C428 (b); a model's fact about
//  the pure liquid, read by `hansenMixture` and the Explorer's solvent lens).
//  Hansen 1967 thesis, Table 2.1 row 23 "Diethyl ether", revised placements:
//  delta_d = 7.05, delta_p = 1.4, delta_h = 2.5 (cal/cm3)^0.5, x sqrt(4.184e6) = 2045.4828.
hansen
{
    dD    14420.7;        // Pa^0.5   = 7.05 (cal/cm3)^0.5, thesis Table 2.1 row 23
    dP    2863.7;        // Pa^0.5   = 1.4
    dH    5113.7;        // Pa^0.5   = 2.5
    Tref  298.15 K;       // adopted: the thesis prints no temperature beside Table 2.1
}

provenance
{
    hansen
    {
        origin        literature;
        method        "Hansen 1967 thesis, Table 2.1 row 23 (Diethyl ether), revised placements; (cal/cm3)^0.5 x 2045.4828 -> Pa^0.5";
        citation      "Hansen, C. M., The Three Dimensional Solubility Parameter and Solvent Diffusion Coefficient, doctoral dissertation, Danish Technical Press, Copenhagen (1967), Table 2.1 (pages 18-19), row 23; no DOI";
        reviewStatus  interim;
        notes         "transcribed from the page image 2026-10-21; Tref 298.15 K adopted, the thesis states no temperature beside the table";
    }
    uniquac
    {
        origin        definition;
        method        "sum of UNIFAC group R_k/Q_k: r = sum nu_k R_k = 3.3949, q = sum nu_k Q_k = 3.0160 over the record's unifac groups (2 CH3 + 1 CH2 + 1 CH2O)";
        citation      "R_k and Q_k of Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, Ind. Eng. Chem. Res. 30 (1991) 2352, as tabulated in data/standards/parameters/UNIFAC/groups.dat; the group sum of Fredenslund, Jones & Prausnitz, AIChE J. 21 (1975) 1086";
    }
    dHf_298
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "CH2:2,CH3:2,ether:1";
        uncertainty      { status unquantified; reason "bulk-import band ~9 kJ/mol, primary basis not verified"; }
    }

    constants      "CoolProp 7.2.0 -- Thol-IJT-2014";
    vaporPressure  "Antoine fitted to CoolProp EOS saturation, AAD 0.45%";
    idealGasCp     "polynomial fitted to CoolProp cp0, maxerr 0.00%";
    liquidCp       "polynomial fitted to CoolProp sat-liquid cp, maxerr 0.00%";
    triplePoint    "CoolProp reference EOS triple-point T,P";
    preserved      "from prior proposal (NOT CoolProp): standardThermochemistry, groups";
    liquidViscosity
    {
        origin        fitted;
        method        "least squares on ln y of ln(mu/Pa.s) = A + B/T + C ln T (chemsepEq101 with D = 0), 3 parameter(s), then the largest relative error minimised; every laboratory the archive holds for the pure liquid at <= 200 kPa; points beyond 15 % after the first stage discarded by name";
        fittedBy      "bin/curate/transport_fit.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4: nobody has reviewed it
