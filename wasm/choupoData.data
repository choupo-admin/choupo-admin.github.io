                { doi "10.1016/j.fluid.2011.12.015"; articleSha256 "0578af2666b6d63520a056bc16e2acacac449615c0e3cd17bc9f0f86ca10b265"; pointsKept 13; pointsDropped 0; provenance measured; }
                { doi "10.1021/acs.jced.7b00543"; articleSha256 "2b91aa39199c44fe4687402afb802854577ee007ab23cdfa3b592f1355de1df3"; pointsKept 29; pointsDropped 0; provenance measured; }
                { doi "10.1021/je034093m"; articleSha256 "bc6f29c146c8521b0ebf864ba8776b4ea9fa354f594f002da9db280d0ce08ad8"; pointsKept 80; pointsDropped 0; provenance measured; }
        );
        acceptance
        {
