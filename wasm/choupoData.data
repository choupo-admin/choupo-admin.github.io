Tc          905;      // K [origin=ChemSep v8.3]
Pc          26.1;      // bar; source Pa / 1e5 [origin=ChemSep v8.3]
omega       0.587526;      // [-] [origin=ChemSep v8.3]
Tb          655.95;      // K [origin=ChemSep v8.3]

standardThermochemistry
{
    dHf_298   288900;        // J/mol   [ChemSep v8.3, ideal gas]
    s_298     418.5;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
