name        123Trimethylbenzene;
CAS         526-73-8;
formula     C9H12;      // counted from the ChemSep v8.3 structure formula "(C6H3)(CH3)3" (derived 2026-09-03; reproduces MW to 0.003 %)
reviewStatus interim;
MW          120.1916;      // kg/kmol [origin=ChemSep v8.3]
Tc          664.5;      // K [origin=ChemSep v8.3]
Pc          34.54;      // bar; source Pa / 1e5 [origin=ChemSep v8.3]
omega       0.367;      // [-] [origin=ChemSep v8.3]
Tb          449.23;      // K [origin=ChemSep v8.3]

standardThermochemistry
{
    dHf_298   -9568.81;        // J/mol   [ChemSep v8.3, ideal gas]
    s_298     380.5;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.36729768  1756.981756  -46.375);
    Trange        (399.82  595);
}

Vliq        0.000134808;      // m3/mol at 25 C  [ChemSep eqno 105]
