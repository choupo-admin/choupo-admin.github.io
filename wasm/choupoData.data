}

provenance
{
    hansen
    {
        origin        literature;
        method        "Hansen 1967 thesis, Table 2.1 row 62 (Hexane), revised placements; (cal/cm3)^0.5 x 2045.4828 -> Pa^0.5";
        citation      "Hansen, C. M., The Three Dimensional Solubility Parameter and Solvent Diffusion Coefficient, doctoral dissertation, Danish Technical Press, Copenhagen (1967), Table 2.1 (pages 18-19); no DOI. Cross-check read on the page image: Hansen, Ind. Eng. Chem. Prod. Res. Dev. 8 (1969) 2, doi 10.1021/i360029a002, Table I row Z07: 7.24 / 0.0 / 0.0, identical";
        reviewStatus  interim;
        notes         "transcribed from the thesis page image 2026-10-21; cross-read on the 1969 paper's page image 2026-11-17 (same three digits); Tref 298.15 K adopted, the thesis states no temperature beside the table";
    }
    uniquac
    {
        origin        definition;
        method        "sum of UNIFAC group R_k/Q_k: r = sum nu_k R_k = 4.4998, q = sum nu_k Q_k = 3.8560 over the record's unifac groups (2 CH3 + 4 CH2)";
        citation      "R_k and Q_k of Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, Ind. Eng. Chem. Res. 30 (1991) 2352, as tabulated in data/standards/parameters/UNIFAC/groups.dat; the group sum of Fredenslund, Jones & Prausnitz, AIChE J. 21 (1975) 1086";
    }
    liquidViscosity
