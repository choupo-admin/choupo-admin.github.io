\*---------------------------------------------------------------------------*/

name        fluoranthene;
CAS         206-44-0;
formula     C16H10;      // counted from the ChemSep v8.3 structure formula "C16H10" (derived 2026-09-03; reproduces MW to 0.003 %)
reviewStatus interim;
