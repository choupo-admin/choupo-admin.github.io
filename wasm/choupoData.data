// no coefficient or domain touched.
gasSpecies        heptanol1;
dissolvedSpecies  heptanol1;
convention        Sander-Hxp-v1;

model       vantHoff;
H_ref       1.4232e+05 Pa;
T_ref       298.15 K;
enthalpy    -58369  J/mol;
Trange      ( 273  373 );
