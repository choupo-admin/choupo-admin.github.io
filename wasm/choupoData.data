/*--------------------------------*- Choupo -*-----------------------*\
  Component: Methyl radical (dominant intermediate in CH4 / CH3OH oxidation)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "CH3", appendix D p. 82 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 14 (s_298).  The report's own sources
  for this species: D0(H3C-H): Ruscic,1999. Jacox,1998.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Re-sourced 2026-11-01 (DEV.md 4c C170 item 4) by
  bin/curate/nasa_tp2002_to_choupo.py from the NonCommercial compilation
  this record was first generated from: the report's values
  agree with the old ones to within dHf 0.5 kJ/mol, s 0.02 J/(mol K)
  and Cp 2 % (the record's own old Trange), and replace them; not yet
  read back by a curator.
\*---------------------------------------------------------------------------*/

name           CH3;
formula        CH3;
CAS            2229-07-4;

MW             15.0345;       // kg/kmol
role        nonvolatile;
tags           ( radical gasPhase combustion );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";

standardThermochemistry
{
    dHf_298    146658.040;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 82, entry CH3
    s_298      194.009;     // J/(mol·K) -- third-law absolute; Table B1, p. 14
}


idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 82, entry CH3, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -2.876188806e+04 5.093268660e+02 2.002143949e-01 1.363605829e-02 -1.433989346e-05 1.013556725e-08 -3.027331936e-12 );
    high     ( 2.760802663e+06 -9.336531170e+03 1.487729606e+01 -1.439429774e-03 2.444477951e-07 -2.224555778e-11 8.395065760e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 82, entry CH3, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 14 prints 146.658 kJ/mol; the report's own sources: D0(H3C-H): Ruscic,1999. Jacox,1998.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 14, entry CH3";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 194.009";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 82, entry CH3, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
/*--------------------------------*- Choupo -*-----------------------*\
  Component: Carbon dioxide  (CO2, CAS 124-38-9)
  Above its triple point (216.55 K, 5.18 bar) CO2 has a normal liquid
  range only up to Tc = 304.13 K.  In process work above ambient T it
  is permanently gaseous.
  Sources: constants (Tc, Pc, omega, MW, Tb) cross-checked against the
  CoolProp 7.2.0 reference equation of state (MIT-licensed); ideal-gas
  formation properties (dHf_298, s_298) from NASA TM-4513 (McBride-
  Gordon-Reno 1993).
\*---------------------------------------------------------------------------*/

name        CO2;
formula     CO2;
noncondensable true;     // permanent carrier gas (psychrometric carrier)
CAS         124-38-9;

// role solute (v0.28+): when the thermo package declares a solvent
// for which a HenrysLaw/CO2-<solvent>.dat entry exists (water,
// MEA, ...), the K-value comes from Henry's law instead of the
// Raoult/γ-φ form.  Falls back to Raoult/γ-φ when no Henry entry
// is available --- backwards-compatible with existing CO2-bearing
// tutorials (gibbs cases use GibbsReactor, which does not call Kvec).
role        solute;

MW          44.010;       // kg/kmol
Tc          304.13;       // K
Pc          73.83;        // bar
omega       0.225;        // [-]
Tb          194.65;       // K  (sublimation point at 1 atm)
HvapTb      25230;        // J/mol  (estimate at triple-point T)
Vliq        4.70e-5;      // m^3/mol  (47.0 cm^3/mol at 273 K)
VliqT       273.15;      // K -- the temperature Vliq belongs to: the record's own statement ("at 273 K"), read as 273.15 K; the reference equation gives 47.45 cm^3/mol there (batch vliq_datum_temperature)
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 14560;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]
diffusionVolume  26.9;          // Fuller diffusion volume [-]

standardThermochemistry
{
    dHf_298   -393520.0;          // J/mol  -- ideal-gas reference
    s_298     213.790;            // J/(mol·K)  -- third-law absolute
}

vaporPressure
{
    model         Antoine;
    coefficients  (6.81228   1301.679   -3.494);
    Trange        (154  204);
}

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol·K)] = a0 + a1*T + a2*T^2 + a3*T^3  (ideal-gas Cp
    // polynomial -- individual literature value, primary re-citation pending)
    coefficients  (19.80   7.344e-2   -5.602e-5   1.715e-8);
    Trange        (250  1500);
}

// Liquid Cp -- physically extrapolated stub (CO2 is gas or solid at
// normal P; liquid only above 5.18 bar).  Same purpose as the N2 stub.
liquidHeatCapacity
{
    model         polynomial;
    coefficients  (90.0);          // J/(mol·K), constant approximation
}

// Friendly-name aliases (resolved to this file via the generated ALIASES index).
aliases ( carbonDioxide );

// ---- Aqueous-speciation FACT (substance-level, classifier-read) ----
// CO2 + H2O = HCO3- + H+ (CO2aq-formation): the carbonate
// set, master HCO3.
aqueousSpeciation  carbonate;
aqueousMapping ( { species HCO3; nu 1; } { species H; nu 1; } );

cosmo
{
    LVPP-HFTZVP-2018
    {
        model       COSMOSAC;
        variant     "LVPP-HFTZVP-2018";
        protocol    "LVPP-18.07 GAMESS HF/TZVP; r_av 1.4 A; f_decay 3.57; d in A; sigma = q/a";
        source      "LVPP sigma-profile database release 18.07 (github.com/lvpp/sigma, asset HF_TZVP.zip, sha256 bd17aaeebb430641...), file CARBON_DIOXIDE.gout; MIT License, Copyright (c) 2017 LVPP; cite Ferrarini, Flores, Muniz & Soares, AIChE J. 64 (2018) 3443, doi:10.1002/aic.16194, and doi:10.5281/zenodo.3613786; identity: InChIKey CURLTUGMZLYLDI-UHFFFAOYSA-N (full match); formula CO2; resolved by thirdParty/thermoml/identity.json (PubChem and CACTUS agree)";
        derivation  "segment areas, charges and the cavity volume are LVPP's (GAMESS HF/TZVP COSMO output); `area` is the sum of LVPP's segment areas as binned (GAMESS's printed cavity area agrees within its 2-decimal rounding); the 51-point profile is COMPUTED BY CHOUPO from LVPP's surface segments by bin/curate/lvpp_sigma_profile.py under the protocol above (Bell et al. 2020 Eq. 4 averaging, sigma = q/a, area split linearly between grid nodes)";
        licence     MIT;
        installed   true;
        area        65.051554;   // sum of the profile below; GAMESS prints 65.05
        volume      46.77;
        sigmaProfile  (
