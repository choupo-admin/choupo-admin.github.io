model pitzer;

pair { cation Na; anion B3O3OH4; }

parameters
{
    beta0 -0.056;
    beta1 -0.91;
    beta2 0.0;
    Cphi 0.0;
    alpha1 2.0;
    alpha2 12.0;
}

source "Felmy & Weare, Geochim. Cosmochim. Acta 50 (1986) 2771-2783, Table 3, p. 2773 (25 C)";

provenance
{
    origin        literature;
