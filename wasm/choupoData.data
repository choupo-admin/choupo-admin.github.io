standardThermochemistry
{
    dHf_298   -304040;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     392.13;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

