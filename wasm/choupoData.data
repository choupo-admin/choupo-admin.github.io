/*--------------------------------*- Choupo -*-----------------------*\
  Substance: Lithium chloride (LiCl, CAS 7447-41-8)

  UNIFIED substance file.  A non-volatile, fully-dissociating 1-1 salt
  (Li+ + Cl-), the most soluble common chloride (~19.9 mol/kg at 25 C) --
  which is WHY the salar/brine route works (Li stays in the mother liquor while
  NaCl/KCl crystallise out).  The Li+/Cl- ions live in species/aqueous/; the
  Li-Cl Pitzer pair is curated in parameters/Pitzer/pairs/.
  Promoted to the standard catalogue (was case-local in lithiumBrinePlant).

  Sources: MW from atomic weights (IUPAC); solid rho_p 2068 kg/m^3
  (crystallographic, public domain); solubility 19.9 mol/kg (25 C) -- primary
  re-citation pending (candidate: Linke & Seidell, Solubilities, 4th ed.);
  liquid-Cp an ASSERTED energy-closure proxy (see the block).
\*---------------------------------------------------------------------------*/

name           LiCl;
formula        LiCl;
CAS            7447-41-8;

MW             42.394;         // g/mol
role        nonvolatile;

// APPARENT COMPONENT view -- the balance/representation map (apparent -> ions).
dissociatesTo  { Li 1; Cl 1; }   // ion stoichiometry (formula-like identity)

// Anhydrous LiCl crystal (the LiCl.H2O hydrate is a separate mineral phase).
rho_p   2068.0;     // crystalline LiCl density [kg/m^3]
k_v     1.0;        // volume shape factor (cube)


liquidHeatCapacity
{
    model         polynomial;
    coefficients  (50.0);      // J/(mol.K), constant
    Trange        (270  400);
    origin        asserted;
    why           "temporary energy-closure proxy; solid-lattice Dulong-Petit 6R value reused; not a physical liquid-LiCl Cp model";
}
/*--------------------------------*- Choupo -*-----------------------*\
  Component: 1Octanol  (octan-1-ol; CAS 111-87-5)
  NEW in the catalogue (DEV.md 4c C292, slice 2 of C287, 2026-11-10), built by
  bin/curate/c287_new_components.py from measurements the NIST/TRC ThermoML Archive
  locates (the articles are the sources; their DOIs are in provenance).
  MEASURED: no critical constant, no Tb.  FITTED: vapour pressure (bin/choupo-curate vp),
  Vliq, liquid Cp.  DERIVED: omega (from the fitted vapour pressure at the ESTIMATED Tc).
  ESTIMATED (Joback): Tc, Pc, ideal-gas Cp, dHf_298; s_298 derived from Joback's
  dHf and dGf.  No measured series is reproduced here.
  reviewStatus autoPromoted, humanReviewed false: NO human has read it back.
  Psat: fitted by `bin/choupo-curate vp`; its promotion replaced the
  AmbroseWalton block this tool writes (provenance.vaporPressure).
\*---------------------------------------------------------------------------*/

name        1Octanol;
CAS         111-87-5;
formula     C8H18O;
reviewStatus autoPromoted;
humanReviewed false;
MW          130.2310;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          634.648434;      // K, Joback ESTIMATE (provenance.Tc)
Pc          27.8766159;      // bar, Joback ESTIMATE (provenance.Pc)
omega       0.769443;      // [-] (provenance.omega)
//  Tb: NOT DECLARED -- the archive reports no boiling temperature at
//  101.3 kPa for it, and a Tb read back off the fitted Antoine would be
//  the curve tested against itself (the fitted normal boiling point is
//  in provenance.vaporPressure.acceptance.Tnb_fit).  Joback's Tb is NOT stored either: the vapour-pressure
//  grade would read an estimate as a measurement (WRITE_ESTIMATED_TB in
//  the tool); the case data/curation/batches/new_components_estimated prints it.

standardThermochemistry
{
    dHf_298   -360680;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     518.51;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (4.00937961  1350.831959  -132.5414178);
    Trange        (298.15  468.47);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        1.576533e-04;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (0.907  0.79782  -4.418000e-04  9.380000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, FITTED (provenance.liquidHeatCapacity)
    coefficients  (-2361.343213  16.26106806  -0.02431188435);
    Trange        (288.15  333.15);
}

