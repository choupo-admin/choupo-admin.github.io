provenance
{
    uniquac
    {
        origin        definition;
        method        "sum of UNIFAC group R_k/Q_k: r = sum nu_k R_k = 5.0469, q = sum nu_k Q_k = 4.3720 over the record's unifac groups (1 CH3 + 3 CH2 + 1 C2H5O2)";
        citation      "R_k and Q_k of Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, Ind. Eng. Chem. Res. 30 (1991) 2352, as tabulated in data/standards/parameters/UNIFAC/groups.dat; the group sum of Fredenslund, Jones & Prausnitz, AIChE J. 21 (1975) 1086";
    }
    groups
    {
        origin       definition;
        method       "unifac: the original UNIFAC subgroups assigned from the structure CH3(CH2)3-[O-CH2CH2-OH]; [..] = C2H5O2; atom count of the decomposition equals the formula C6H14O2 (checked when written, 2026-11-11) and agrees with the unifac_choupo column of data/groupEstimative/compounds.csv";
        citation     "subgroup definitions of Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, Ind. Eng. Chem. Res. 30 (1991) 2352, as tabulated in data/standards/parameters/UNIFAC/groups.dat";
    }
