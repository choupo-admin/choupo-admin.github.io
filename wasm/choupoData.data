/*--------------------------------*- Choupo -*-----------------------*\
  Component: D-Glucose (C6H12O6, CAS 50-99-7)

  A non-volatile non-electrolyte solute --- a canonical NF tutorial
  case (sugar separation from water).  Glucose does not dissociate
  in water; the van't Hoff factor is 1.

  Typical industrial concentrations: <100 g/L for food / pharma
  separations.  NF membranes partially reject glucose
  (MW 180 ≈ NF270 cutoff of 200 Da), giving the partial-rejection
  curve that pedagogically distinguishes NF from RO.
  Sources: dHf_298 from Ponomarev & Migarskaya, Russ. J. Phys. Chem. 34
           (1960) -- combustion calorimetry; s_298 from Boerio-Goates,
           J. Chem. Thermodyn. 23 (1991) -- adiabatic calorimetry (full
           citations at the standardThermochemistry block).  MW from standard
           atomic weights; solid Cp deliberately absent (flagged, not
           fabricated -- see body).
\*---------------------------------------------------------------------------*/

name           glucose;
formula        C6H12O6;
CAS            50-99-7;

MW             180.16;         // g/mol
role        nonvolatile;
dissociation   1;              // non-electrolyte
Vliq           1.1199e-4;     // m^3/mol -- STANDARD PARTIAL molar volume of D-glucose(aq) at infinite dilution, 298.15 K (see provenance)


// ---------------------------------------------------------------------------
// Standard enthalpy + entropy of formation of CRYSTALLINE alpha-D-glucose.
// ARITY-1 INTRINSIC (the molecule + its elements): lives here in the
// component .dat, NOT in a solvent tier (see docs/ai/data-doctrine.md).
// phase = solid: glucose decomposes before it vaporises, so NIST/primary
// tables give the SOLID datum -- the energy ladder never integrates a
// glucose vapour leg (the phase keyword routes it on the solid line, exactly
// as for sucrose; see theoryGuide.tex sec:gibbs-phase).
//
// PRIMARY (dHf_298): Ponomarev & Migarskaya, "Heats of combustion of some
//   monosaccharides", Russ. J. Phys. Chem. 34 (1960) 1182-1183 -- combustion
//   calorimetry, dHc = -(2801.5 +/- 0.5) kJ/mol => dHf(cr) = -(1274.6 +/- 0.6)
//   kJ/mol.  (The rounded -1273.3 kJ/mol seen in textbooks traces to the same
//   combustion lineage; the calorimetric primary value is kept.)
// PRIMARY (s_298): Boerio-Goates, "Heat-capacity measurements and
//   thermodynamic functions of crystalline alpha-D-glucose at temperatures
//   from 10 K to 340 K", J. Chem. Thermodyn. 23 (1991) 403-409 -- adiabatic
//   calorimetry; S(298.15 K) = (209.2 +/- 0.4) J/(mol K).
standardThermochemistry
{
    dHf_298    -1274600.0;   // J/mol  (-1274.6 kJ/mol, crystalline alpha-D-glucose)
                             //   [Ponomarev & Migarskaya 1960, combustion]
    s_298      209.2;        // J/(mol K), third-law absolute
                             //   [Boerio-Goates 1991, adiabatic calorimetry]
    referenceState      pureSolid;
}

// solidHeatCapacity -- the SOLID crystal Cp.  PRIMARY would be Boerio-Goates
// 1991 (same adiabatic-calorimetry study, Cp tabulated 10-340 K).  FLAGGED,
// NOT FABRICATED: the exact Cp(298.15 K) value was not transcribable from a
// clean primary at curation time, and glucose is dissolved-only in every
// shipped case (NF separation: no energy balance runs on the solute, water
// dominates Cp by orders of magnitude -- the same closure rationale as NaCl).
// Fill `coefficients` from Boerio-Goates 1991 Table before any case runs a
// solid-glucose energy balance.  Do NOT invent a number.

// liquidHeatCapacity -- the STANDARD PARTIAL molar heat capacity of
// D-glucose(aq) at infinite dilution, C_p,2,m (see provenance).  Like Vliq,
// it is a property of glucose IN WATER, which is the only liquid glucose any
// case here holds (a pure liquid glucose does not exist at these T): in the
// ideal-solution sum Cp = x_w Cp_w + x_g Cp_g it gives the dilute solution's
// heat capacity.  The paper's own Taylor expansion about T' = 298.15 K,
//     C = 345 + 1.45 (T - T') + (1/2) 0.053 (T - T')^2   [J/(K mol)],
// written out in powers of T for the engine's polynomial:
liquidHeatCapacity
{
    model         polynomial;
    coefficients  (2268.35819625  -14.35195  0.0265);
    Trange        (298.15  327.01);     // the measured window; outside it the engine announces extrapolation
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (1 CH2 + 4 CH + 5 OH + 1 CHO), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   8.4600;
    q   8.4000;
}

groups
{
    unifac ( { group CH2; count 1; } { group CH; count 4; } { group OH; count 5; } { group CHO; count 1; } );   // added from data/groupEstimative (UNIFAC decomposition; vocab-checked vs groups.dat)
}

provenance
{
    uniquac
    {
        origin        definition;
        method        "sum of UNIFAC group R_k/Q_k: r = sum nu_k R_k = 8.4600, q = sum nu_k Q_k = 8.4000 over the record's unifac groups (1 CH2 + 4 CH + 5 OH + 1 CHO)";
        citation      "R_k and Q_k of Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, Ind. Eng. Chem. Res. 30 (1991) 2352, as tabulated in data/standards/parameters/UNIFAC/groups.dat; the group sum of Fredenslund, Jones & Prausnitz, AIChE J. 21 (1975) 1086";
    }
    Vliq
    {
        origin           measured;
        method           "vibrating-tube densimetry of aqueous glucose, 0.20-1.54 mol/kg; V-infinity by a Taylor-expansion fit of the apparent molar volume in T and molality";
        citation         "Kishore, Goldberg & Tewari, J. Chem. Thermodyn. 25 (1993) 847-859, doi:10.1006/jcht.1993.1082 -- final values, p. 856";
        uncertainty      "0.10 cm3/mol (the paper's final estimate, systematic errors included)";
        note             "V2,m = 111.99 cm3/mol at T = 298.15 K, measured AT that temperature.  Independent cross-check: Seitz, Schulte, Hall & Rhett, J. Chem. Thermodyn. 128 (2019) 372-382, doi:10.1016/j.jct.2018.08.020, Table 3 at 0.10 MPa, 110.4 (293.15 K) and 113.1 (313.15 K), u = 1.0 -- linearly interpolated to 298.15 K, 111.1 cm3/mol, inside its own uncertainty of this value (Seitz's own Table 5 re-derives 112.0 from Kishore's data).  Superseded 2026-09-29 the same day it was written: the first entry was the Seitz interpolation, before Kishore's direct 298.15 K value was in hand.  Read off the PDFs Vitor supplied; reviewStatus is not raised by this entry.";
    }
    liquidHeatCapacity
    {
        origin           measured;
        method           "flow calorimetry of aqueous glucose, 0.20-1.54 mol/kg, 298.15-327.01 K; C_p,2,m by a Taylor-expansion fit of the apparent molar heat capacity in T and molality (their Eq. 11)";
        citation         "Kishore, Goldberg & Tewari, J. Chem. Thermodyn. 25 (1993) 847-859, doi:10.1006/jcht.1993.1082 -- final values, p. 856";
        uncertainty      "C_p,2,m (345 +/- 4) J/(K mol); dC/dT (1.45 +/- 0.22) J/(K2 mol); d2C/dT2 (0.053 +/- 0.015) J/(K3 mol) -- the paper's final estimates";
        note             "Coefficients are the paper's Taylor series about 298.15 K expanded into powers of T, no refit: a0 = 345 - 1.45*298.15 + 0.0265*298.15^2, a1 = 1.45 - 2*0.0265*298.15, a2 = 0.0265; they reproduce 345.00 at 298.15 K and 408.92 at 327.01 K.  Trange is the measured window.  The value is for the anomeric EQUILIBRIUM mixture (the solutions were held ~4 h before measurement); the alpha/beta difference is 2 +/- 2 J/(K mol).  Read off the PDF Vitor supplied 2026-09-29; reviewStatus is not raised by this entry.";
    }
}
