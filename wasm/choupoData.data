    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.893662592  3140.817693  -13.315);
    Trange        (543.15  795.17);
}

Vliq        0.000174414;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      57964.9;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
