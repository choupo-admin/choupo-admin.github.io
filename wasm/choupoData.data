formula     C9H20;      // counted from the ChemSep v8.3 structure formula "CH3CH2C(CH3)2CH2CH(CH3)2" (derived 2026-09-03; reproduces MW to 0.003 %)
reviewStatus interim;
MW          128.2551;      // kg/kmol [origin=ChemSep v8.3]
Tc          583;      // K [origin=ChemSep v8.3]
Pc          25;      // bar; source Pa / 1e5 [origin=ChemSep v8.3]
omega       0.352203;      // [-] [origin=ChemSep v8.3]
Tb          403.81;      // K [origin=ChemSep v8.3]

standardThermochemistry
{
    dHf_298   -240300;        // J/mol   [ChemSep v8.3, ideal gas]
    s_298     468.4;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (3.981209886  1372.978575  -58.474);
    Trange        (351  514.49);
}

Vliq        0.000177805;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      33852.4;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (84.17  -452.22  6.259244721  0.00035197  -1.1076e-07);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (36.795  -79.414  4.781244721  0.0041098  -3.1494e-06);
    Trange        (200  403.81);
}

liquidViscosity
{
    chemsepEq101
    {
        A     -6.9748;
        B     1194.1;
        C     -0.75025;
        D     -2.9452e-08;
        E     2;
        Tmin  159.78;
        Tmax  524.7;
    }
}

liquidThermalConductivity
{
    chemsepEq16
    {
        A     -0.061213;
        B     3.6115;
        C     -1.5687;
        D     -0.00048198;
        E     -1.134e-06;
        Tmin  159.78;
        Tmax  403.81;
    }
}

