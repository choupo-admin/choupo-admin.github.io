    coefficients  (-42.4685  0.551959  -0.000155651  -3.78747e-08);
    Trange        (200  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp_liq [J/(mol.K)]   -- fitted to CoolProp saturated-liquid cp
    coefficients  (45.0758  0.385964  -0.000153114  3.74301e-07);
    Trange        (284  354);
