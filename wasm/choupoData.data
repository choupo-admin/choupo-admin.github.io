formula     C6H12;      // counted from the ChemSep v8.3 structure formula "CH3CHCHCH(CH3)2" (derived 2026-09-03; reproduces MW to 0.003 %)
reviewStatus interim;
MW          84.15948;      // kg/kmol [origin=ChemSep v8.3]
Tc          499;      // K [origin=ChemSep v8.3]
Pc          32.2;      // bar; source Pa / 1e5 [origin=ChemSep v8.3]
omega       0.244178;      // [-] [origin=ChemSep v8.3]
Tb          329.53;      // K [origin=ChemSep v8.3]

standardThermochemistry
{
    dHf_298   -50333.5;        // J/mol   [ChemSep v8.3, ideal gas]
    s_298     373.338;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (3.968615346  1122.738095  -46.215);
    Trange        (299.87  442.05);
}

Vliq        0.000126654;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      27551;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (101.13  -861.95  6.555244721  -0.00060529  2.0212e-07);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (-59.803  -16.203  4.865244721  0.0034333  -3.7581e-06);
    Trange        (138.3  329.53);
}

liquidViscosity
{
    chemsepEq101
    {
        A     -11.752;
        B     820.42;
        C     0.14056;
        D     -7.3435e-07;
        E     2;
        Tmin  138.3;
        Tmax  405;
    }
}

liquidThermalConductivity
{
    chemsepEq16
    {
        A     -0.050868;
        B     4.0553;
        C     -1.554;
        D     -0.00045968;
        E     -1.981e-06;
        Tmin  138.3;
        Tmax  329.53;
    }
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
