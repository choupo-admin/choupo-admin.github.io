    coefficients  (-6.3604  0.492194  -0.000234339  4.6163e-08);
    Trange        (255  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp_liq [J/(mol.K)]   -- fitted to CoolProp saturated-liquid cp
    coefficients  (53.4291  0.500409  -0.000981391  1.93265e-06);
