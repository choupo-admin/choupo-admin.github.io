  Made by bin/curate/species_c373.py from data/curation/batches/species_c373/*.tsv, which holds every
  reading (source, table, page, whether read from a page image).  Standard state: ideal solution at
  1 mol/kg, 298.15 K, H+ = 0.
  The formation values are DERIVED from printed numbers; the arithmetic, tables and pages are in the
  source line below and in formation.tsv.
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    H4P2O7;
formula     "H4P2O7";
charge  0;
MW { value 177.973; unit g/mol;}
aqueousThermo
{
source "hfAq [kJ/mol] -2258.8: derived: H3P2O7 -2268.0 minus dH_ion1 -9.2, S 246.4 minus dS_ion1 -46.8 (pK1 0.83), steps from GOLD02 Section 8 summary p. 360 (pK, dH_ion of pyrophosphoric acid) -- Wagman, Evans, Parker, Schumm, Halow, Bailey, Churney & Nuttall, The NBS tables of chemical thermodynamic properties, J. Phys. Chem. Ref. Data 11 (1982) Suppl. 2, anchor Table 19:P, p. 2-73 (PDF p. 81), row P2O7 4- ao, steps in steps.tsv (read from a page image), the NBS table prints -2268.6 and 268. for this species, its differences from the evaluated ionisation steps (Goldberg) exceed the Gibbs identity's 0.30 log-unit tolerance (check_logk_crosscheck), so the family is held on ONE scale: the fully dissociated anion as printed and every other species from the evaluated steps, listed in formation_compare.tsv ## sAq [J/mol/K] 293.2: derived: H3P2O7 -2268.0 minus dH_ion1 -9.2, S 246.4 minus dS_ion1 -46.8 (pK1 0.83), steps from GOLD02 Section 8 summary p. 360 (pK, dH_ion of pyrophosphoric acid) -- Wagman, Evans, Parker, Schumm, Halow, Bailey, Churney & Nuttall, The NBS tables of chemical thermodynamic properties, J. Phys. Chem. Ref. Data 11 (1982) Suppl. 2, anchor Table 19:P, p. 2-73 (PDF p. 81), row P2O7 4- ao, steps in steps.tsv (read from a page image)";
hfAq { value -2258800; unit J/mol;}
sAq  { value 293.2; unit J/mol/K;}
}
