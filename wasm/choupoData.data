// PC-SAFT non-associating segment parameters (Gross & Sadowski, IECR 40
// (2001) 1244, Table 1 -- the pure n-alkane fit to vapour pressure + liquid
// density).  m segments, sigma [Angstrom], epsilon/k [K].
pcsaft
{
    m        1.0000;
    sigma    3.7039;
    epsilonK 150.03;
    source   "Gross & Sadowski, Ind. Eng. Chem. Res. 40 (2001) 1244, Table 1";
}

// ---- Aqueous-speciation FACT (substance-level, classifier-read) ----
// dissolved methane is a NEUTRAL master (no aqueous
// equilibria beyond dissolution); role solute carries the Henry route.
aqueousSpeciation  none;
/*--------------------------------*- Choupo -*-----------------------*\
  Component: Vinyl radical (ethylene oxidation; C2 chain carrier)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "C2H3,vinyl", appendix D p. 90 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 15 (s_298).  The report's own sources
  for this species: Radical. Ervin,1990.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Transcribed 2026-10-25 by bin/curate/nasa_tp2002_to_choupo.py (DEV.md
  4c C164), which holds H and S at 298.15 K recomputed from the printed
  coefficients to the printed values; not yet read back by a curator.
\*---------------------------------------------------------------------------*/

name           C2H3;
formula        C2H3;
CAS            n/a;        // radical registry number: pending curation

MW             27.046;       // kg/kmol
role        nonvolatile;
tags           ( radical gasPhase combustion );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";

standardThermochemistry
{
    dHf_298    299686.817;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 90, entry C2H3,vinyl
    s_298      233.663;     // J/(mol·K) -- third-law absolute; Table B1, p. 15
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 90, entry C2H3,vinyl, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -3.347896870e+04 1.064104103e+03 -6.403857060e+00 3.934515480e-02 -4.760046090e-05 3.170071350e-08 -8.633406430e-12 );
    high     ( 2.718080093e+06 -1.030956829e+04 1.836579807e+01 -1.580131153e-03 2.680594939e-07 -2.439003999e-11 9.209096390e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 90, entry C2H3,vinyl, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 15 prints 299.687 kJ/mol; the report's own sources: Radical. Ervin,1990.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 15, entry C2H3,vinyl";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 233.663";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 90, entry C2H3,vinyl, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
