formula     C5H10;      // counted from the ChemSep v8.3 structure formula "CH3CHC(CH3)CH3" (derived 2026-09-03; reproduces MW to 0.003 %)
reviewStatus interim;
MW          70.1329;      // kg/kmol [origin=ChemSep v8.3]
Tc          470;      // K [origin=ChemSep v8.3]
Pc          38.6;      // bar; source Pa / 1e5 [origin=ChemSep v8.3]
omega       0.339;      // [-] [origin=ChemSep v8.3]
Tb          311.7;      // K [origin=ChemSep v8.3]

standardThermochemistry
{
    dHf_298   -41800;        // J/mol   [ChemSep v8.3, ideal gas]
    s_298     338.6;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.144938905  1155.006175  -32.673);
    Trange        (282.62  417.8);
}

Vliq        0.000107237;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      26269.6;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (75.343  -774.17  6.067244721  -0.00022009  6.0763e-08);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (127.04  1071.7  -14.79075528  0.075072  -8.9164e-05);
    Trange        (139.39  311.71);
}

liquidViscosity
{
    chemsepEq101
    {
        A     -11.234;
        B     703.42;
        C     0.094871;
        D     -1.7625e-06;
        E     2;
        Tmin  139.39;
        Tmax  373;
    }
}

liquidThermalConductivity
{
    chemsepEq16
    {
        A     -0.050847;
        B     3.0532;
        C     -1.4724;
        D     -0.00063704;
        E     -2.0121e-06;
        Tmin  139.39;
        Tmax  311.7;
    }
}
solubilityParameter 15210;   // Pa^0.5  [ANCHOR, ChemSep v8.3 -- checked against, never used]

