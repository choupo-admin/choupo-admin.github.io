  as printed) and Table B1 p. 14 (s_298).  The report's own sources
  for this species: Hf:Gurvich,1991 pt1 p67. Jacox,1998 p271.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Transcribed 2026-10-25 by bin/curate/nasa_tp2002_to_choupo.py (DEV.md
  4c C164), which holds H and S at 298.15 K recomputed from the printed
  coefficients to the printed values; not yet read back by a curator.
\*---------------------------------------------------------------------------*/

name           CH3O;
formula        CH3O;
CAS            n/a;        // radical registry number: pending curation

MW             31.034;       // kg/kmol
role        nonvolatile;
tags           ( radical gasPhase combustion );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";

standardThermochemistry
{
    dHf_298    13000.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 83, entry CH3O
    s_298      236.066;     // J/(mol·K) -- third-law absolute; Table B1, p. 14
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 83, entry CH3O, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 8.657117660e+04 -6.631685250e+02 2.257455672e+00 2.266283789e-02 -2.970566403e-05 2.199341353e-08 -6.588043380e-12 );
    high     ( 2.101188243e+06 -8.841968800e+03 1.822645731e+01 -1.743485034e-03 3.340434270e-07 -3.430673160e-11 1.473897771e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 83, entry CH3O, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 14 prints 13.0 kJ/mol; the report's own sources: Hf:Gurvich,1991 pt1 p67. Jacox,1998 p271.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 14, entry CH3O";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 236.066";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 83, entry CH3O, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
