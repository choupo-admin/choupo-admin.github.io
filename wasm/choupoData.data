/*--------------------------------*- Choupo -*-----------------------*\
  Component: Hydroperoxyl radical (key chain carrier in low- and intermediate-T oxidation)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "HO2", appendix D p. 130 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 21 (s_298).  The report's own sources
  for this species: Hf:Hills,1984 & NASA data. Jacox,1998 p153.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Re-sourced 2026-11-01 (DEV.md 4c C170 item 4) by
  bin/curate/nasa_tp2002_to_choupo.py from the NonCommercial compilation
  this record was first generated from: the report's values
  agree with the old ones to within dHf 0.5 kJ/mol, s 0.02 J/(mol K)
  and Cp 2 % (the record's own old Trange), and replace them; not yet
  read back by a curator.
\*---------------------------------------------------------------------------*/

name           HO2;
formula        HO2;
CAS            3170-83-0;

MW             33.0067;       // kg/kmol
role        nonvolatile;
tags           ( radical gasPhase combustion );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";

standardThermochemistry
{
    dHf_298    12020.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 130, entry HO2
    s_298      229.106;     // J/(mol·K) -- third-law absolute; Table B1, p. 21
}


idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 130, entry HO2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -7.598882540e+04 1.329383918e+03 -4.677388240e+00 2.508308202e-02 -3.006551588e-05 1.895600056e-08 -4.828567390e-12 );
    high     ( -1.810669724e+06 4.963192030e+03 -1.039498992e+00 4.560148530e-03 -1.061859447e-06 1.144567878e-10 -4.763064160e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 130, entry HO2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 21 prints 12.02 kJ/mol; the report's own sources: Hf:Hills,1984 & NASA data. Jacox,1998 p153.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 21, entry HO2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 229.106";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 130, entry HO2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
