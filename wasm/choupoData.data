/*--------------------------------*- Choupo -*-----------------------*\
  Component: Oxygen  (O2, CAS 7782-44-7)
  Element in its standard state -- dHf_298 = 0 by definition; the
  third-law absolute entropy is the only thermodynamic anchor.
  Permanent gas at all process temperatures (Tc = 154.58 K).
  Sources: constants (Tc/Pc/omega/MW/Tb) cross-checked vs CoolProp 7.2.0
  reference EOS; standardThermochemistry cross-checked vs NASA TM-4513
  (McBride-Gordon-Reno 1993); idealGasHeatCapacity -- individual
  literature value, primary re-citation pending (IST review).
\*---------------------------------------------------------------------------*/

name        O2;
formula     O2;
noncondensable true;     // permanent carrier gas (psychrometric carrier)
CAS         7782-44-7;

MW          31.999;       // kg/kmol
Tc          154.58;       // K
Pc          50.43;        // bar
omega       0.022;        // [-]
Tb          90.17;        // K
HvapTb      6820;         // J/mol
Vliq        2.80e-5;      // m^3/mol  (28.0 cm^3/mol at Tb)
VliqT       90.17;       // K -- the temperature Vliq belongs to: the record's own statement ("at Tb")
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 8182;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]
diffusionVolume  16.3;          // Fuller diffusion volume [-]

standardThermochemistry
{
    dHf_298   0.0;                // J/mol  -- element in standard state
    s_298     205.150;            // J/(mol·K)  -- third-law absolute
}

vaporPressure
{
    model         Antoine;
    coefficients  (3.9523   340.024   -4.144);
    Trange        (54  154);
}

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol·K)] = a0 + a1*T + a2*T^2 + a3*T^3
    coefficients  (28.11   -3.680e-6   1.746e-5   -1.065e-8);
    Trange        (250  1500);
}

// Friendly-name aliases (resolved to this file via the generated ALIASES index).
aliases ( oxygen );

// ---- Aqueous-speciation FACT (substance-level, classifier-read) ----
// dissolved oxygen: neutral master, no aqueous equilibria
// in the standard network.
aqueousSpeciation  none;

surfaceTension
{
    A     0.03898156977;
    B     0;
    Tc    154.58;
    n     1.232543101;
    Tmin  80;
    Tmax  132;
}

provenance
{
    surfaceTension
    {
        origin        fitted;
        method        "least squares on ln sigma of sigma/(N/m) = A tau^n, tau = 1 - T/Tc (A, n; B = 0; Tc the record's own), then the largest relative error minimised; every laboratory the archive holds for the pure liquid at <= 200 kPa; points beyond 15 % after the first stage discarded by name";
        fittedBy      "bin/curate/transport_fit.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4: nobody has reviewed it
        fitGrade      warning;   // DEV.md 4c C336 class B limits 10 / 20 / 30 % on the max relative error
        fitGradeBasis inSample;   // DEV.md 4c C300 rule 1
        fitGradeCap   ( singleLaboratory );   // DEV.md 4c C300 rule 2
        fitGradeMaxRelativeError_pct 0.261287;
        Trange        (80 132);   // K, the kept points -- outside it the engine announces an extrapolation
        reviewReason  "regressed by a machine from archive-transcribed measurements; not yet read back against the articles";
        reuse         "Choupo's own regression; the measured points belong to the cited articles and are not reproduced in this record or this tree (DEV.md 4c C328)";
        evidence
        (
                { doi "10.1016/j.fluid.2008.06.016"; articleSha256 "9c6987c2aaf35e08cddfdcedeba2c7104c14905629ab077075ea8a13ce250aab"; pointsKept 8; pointsDropped 0; provenance measured; }
        );
        acceptance
        {
            verdict     accepted;
            studies     1;
            pointsKept  8;
            pointsDropped 0;
            dropped     "none";
            aad_pct     0.170892;
            max_pct     0.261287;
        }
    }
}
/*--------------------------------*- Choupo -*-----------------------*\
  Component: Potassium sulfate (K2SO4), ARCANITE.  CAS 7778-80-5.

  A NON-VOLATILE crystalline salt: never enters the vapour (K = 0).
  Potash-fertiliser (SOP) production, Mannheim-process and sulfate
  crystallisation exercises.  Carries the solid-phase formation datum and a
  real solid heat capacity.

  PRIMARY: Wagman et al., NBS Tables of Chemical Thermodynamic Properties,
  J. Phys. Chem. Ref. Data 11, Suppl. 2 (1982) -- PUBLIC DOMAIN.
\*---------------------------------------------------------------------------*/

name        K2SO4;
formula     K2SO4;
CAS         7778-80-5;

MW          174.259;           // kg/kmol

role        nonvolatile;       // never goes to the vapour (K = 0)

// APPARENT COMPONENT view -- the balance/representation map (apparent -> ions),
// added 2026-10-26 (DEV.md 4c C161/C170) so the DSPM-DE pore, the multi-ionic
// film and the electrodialysis units can decompose this salt into its ions,
// whose transport data live on their own species records.  The van't Hoff
// factor DERIVES from it (Component.cpp); no `dissociation` key beside it.
// The map is identity, not thermochemistry: it adds no formation datum.
dissociatesTo  { K 2; SO4 1; }   // ion stoichiometry (formula-like identity)

solid
{
    rho_p   2660.0;            // arcanite particle density [kg/m^3]
}

standardThermochemistry
{
    dHf_298   -1437790;        // J/mol  [Wagman et al. NBS Tables 1982]
    s_298     175.56;          // J/(mol*K) [Wagman 1982]
    referenceState     pureSolid;
}

solidHeatCapacity
{
    model         polynomial;          // Cp = a0  [J/(mol*K)], constant
    coefficients  ( 131.46 );          // Cp(298) [Wagman et al. NBS Tables 1982]
    Trange        ( 298  600 );        // constant-Cp validity flag (near ambient)
}

provenance
{
    standardThermochemistry { origin literature; method "Wagman et al. NBS Tables 1982"; }
    solidHeatCapacity { origin literature; method "Wagman et al. NBS Tables 1982 (Cp298, carried constant)"; }
    rho_p { origin literature; method "arcanite mineralogical density ~2.66 g/cm3"; }
}

// Solid phase(s) of this component (roadmap Phase D fold-in):
solidPhases
{
    arcanite
    {
        dissolutionReaction { masters ( { ion K; nu 2; } { ion SO4; nu 1; } ); }
        equilibrium { logK25 -1.776; dH 20920; analytic ( 674.142 0.30423 -18037 -280.236 0 -0.000144055 ); source "USGS PHREEQC phreeqc.dat (public domain); lit: ref. 3"; }
    }
}
