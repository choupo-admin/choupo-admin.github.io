/*--------------------------------*- Choupo -*--------------------------------*\
  Component: Succinic acid (butanedioic acid), crystal (C4H6O4).  MW 118.088 g/mol (the engine's atomic weights).

  A NON-VOLATILE crystalline organic solid (mp 189-190 C, Perry's 9th ed. Table 2-2, p. 2-43): never enters the vapour (K = 0),
  no Antoine block.  Built on the citric-acid pattern (components/citricAcid.dat); the C372 campaign had left
  this acid without a component, and C373 builds it from the formation data of Miller & Smith-Magowan (1990),
  with Domalski (1972) as the second reading.

  WHAT THIS RECORD CARRIES, AND WHAT IT DELIBERATELY DOES NOT.

    carries   the crystal formation enthalpy dHf = -940.81 +/- 0.42 kJ/mol
              (Miller & Smith-Magowan, J. Phys. Chem. Ref. Data 19 (1990) 1049, Table 2, p. 1059, row dfH(cr) (their ref. a: the evaluation of Cox & Pilcher 1970; read from a page image));
              the crystal density 1.572 g/cm3 at 25/4 C (Perry's);
              the heat of solution of the pair file parameters/solution/succinicAcid-water.dat.
    does NOT  a standard entropy s_298 and any heat capacity: no work in hand prints them for this crystal
              as a record value (Miller prints S of the crystal only for succinic and fumaric acid, and it
              enters the ions' entropies through the third-law route of its Table 2, not this record).  An
              energy balance that reaches the crystal's or the solution's SENSIBLE heat therefore refuses by
              name, which is the honest behaviour (CLAUDE.md rule 5).

    ALSO BUILT, in their own homes: the succinate family (H2Succ, HSucc, Succ; chemistry/*-formation); pK 4.207 / 5.636 (Goldberg Table 7.57, p. 340).
              Dissolved, this crystal is the molecular master of the family (the hypothetical non-dissociated
              acid); a case that needs the dissociation declares that master.
              Second reading: Domalski, J. Phys. Chem. Ref. Data 1 (1972) 221, Section 6.13, p. 236: succinic acid (c) dHf -224.79 kcal/mol x 4.184 = -940.53 kJ/mol (Section 5.5, p. 225), a second reading, 0.28 kJ/mol away; read from a page image.
\*---------------------------------------------------------------------------*/

name        succinicAcid;
formula     C4H6O4;
MW          118.088;            // kg/kmol

role        nonvolatile;               // crystalline organic acid; never to the vapour (K = 0)
dissociation 1;                 // molecular (the ions are species/, see the header)

solid
{
    rho_p   1572.0;             // crystal density [kg/m^3] [1.572 g/cm3 at 25/4 C, Perry's 9th ed., Table 2-2]
}

standardThermochemistry
{
    dHf_298   -940810;        // J/mol  crystalline [-940.81 +/- 0.42 kJ/mol, Miller & Smith-Magowan 1990]
    referenceState     pureSolid;
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "evaluated enthalpy of formation of the crystal (-940.81 +/- 0.42 kJ/mol); second reading: Domalski, J. Phys. Chem. Ref. Data 1 (1972) 221, Section 6.13, p. 236: succinic acid (c) dHf -224.79 kcal/mol x 4.184 = -940.53 kJ/mol (Section 5.5, p. 225), a second reading, 0.28 kJ/mol away; read from a page image";
        citation      "Miller & Smith-Magowan, J. Phys. Chem. Ref. Data 19 (1990) 1049, Table 2, p. 1059, row dfH(cr) (their ref. a: the evaluation of Cox & Pilcher 1970; read from a page image)";
    }
    rho_p
    {
        origin        literature;
        method        "tabulated crystal density";
        citation      "Perry's Chemical Engineers' Handbook, 9th ed., Table 2-2 'Physical Properties of Organic Compounds', p. 2-43, row Succinic acid (1.572 g/cm3 at 25/4 C)";
    }
}
/*--------------------------------*- Choupo -*-----------------------*\
  Component: Hydrogen chloride  (HCl, CAS 7647-01-0)

  Combustion product of Cl-bearing fuels (PVC, etc.); waste-incinerator
  flue gas.  Strong acid in aqueous absorption.  The HCl + 1/2 O2 ->
  1/2 Cl2 + H2O Deacon process is a Gibbs-equilibrium pedagogical case
  (mildly exothermic, equilibrium-limited at high T).
  Sources: constants cross-checked vs CoolProp 7.2.0 reference EOS (MIT);
           standardThermochemistry vs NASA TM-4513 (McBride-Gordon-Reno 1993).
\*---------------------------------------------------------------------------*/

name        HCl;
formula     HCl;
CAS         7647-01-0;

// role solute (v0.28+): in a water solvent the K-value comes from
// HenrysLaw/HCl-water.dat instead of Antoine/Raoult.
role        solute;

MW          36.461;            // kg/kmol
Tc          324.55;             // K
Pc          83.10;              // bar
omega       0.133;              // [-]
Tb          188.00;             // K
HvapTb      16100;              // J/mol
Vliq        3.05e-5;            // m^3/mol
VliqT       188.00;      // K -- the temperature Vliq belongs to: the stored value is a volume at the normal boiling point: batch vliq_datum_temperature (evidence.tsv; the value is unchanged)
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 12190;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]

standardThermochemistry
{
    dHf_298    -92310.0;        // J/mol  -- ideal-gas reference
    s_298      186.90;          // J/(mol·K)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // Poling, Prausnitz & O'Connell 5e, App. A Antoine set (via the
    // MIT-licensed `chemicals` 1.5.2 data distribution; INTERIM pending
    // primary review (Vitor))
    coefficients  (4.29490   745.780   -14.27);
    Trange        (160  201);
}

idealGasHeatCapacity
{
    model         polynomial;
    coefficients  (30.67   -7.201e-3   1.246e-5   -3.898e-9);
    Trange        (250  1500);
}

cosmo
{
    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "VT-2005 sigma-profile database (Mullins et al., Ind. Eng. Chem. Res. 45 (2006) 4389; DFT-COSMO), file VT2005-1064-PROF.txt bundled in usnistgov/COSMOSAC; CAS 7647-01-0";
        licence     externalRestricted;   // VT-2005: redistribution NOT confirmed -- values NOT shipped
        installed   false;                 // install your own copy: bin/choupo-import-cosmo (-> data/local/cosmo/VT2005/)
    }
}
/*--------------------------------*- Choupo -*-----------------------*\
  Component: Atomic nitrogen radical (Zeldovich chain carrier for thermal NOx)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "N", appendix D p. 152 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 24 (s_298).  The report's own sources
  for this species: Hf:Cox,1989. Moore,1975. Gordon,1999.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Re-sourced 2026-11-01 (DEV.md 4c C170 item 4) by
  bin/curate/nasa_tp2002_to_choupo.py from the NonCommercial compilation
  this record was first generated from: the report's values
  agree with the old ones to within dHf 0.5 kJ/mol, s 0.02 J/(mol K)
  and Cp 2 % (the record's own old Trange), and replace them; not yet
  read back by a curator.
\*---------------------------------------------------------------------------*/

name           N;
formula        N;
CAS            17778-88-0;

MW             14.007;       // kg/kmol
role        nonvolatile;
tags           ( radical gasPhase combustion );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";

standardThermochemistry
{
    dHf_298    472680.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 152, entry N
    s_298      153.302;     // J/(mol·K) -- third-law absolute; Table B1, p. 24
}


idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 152, entry N, a1..a7 as printed.
    //  The report's 6000-20000 K interval is not transcribed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 0.000000000e+00 0.000000000e+00 2.500000000e+00 0.000000000e+00 0.000000000e+00 0.000000000e+00 0.000000000e+00 );
    high     ( 8.876501380e+04 -1.071231500e+02 2.362188287e+00 2.916720081e-04 -1.729515100e-07 4.012657880e-11 -2.677227571e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 152, entry N, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 24 prints 472.68 kJ/mol; the report's own sources: Hf:Cox,1989. Moore,1975. Gordon,1999.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 24, entry N";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 153.302";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 152, entry N, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
