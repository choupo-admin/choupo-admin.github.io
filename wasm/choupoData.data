name        1245Tetramethylbenzene;
CAS         95-93-2;
formula     C10H14;      // counted from the ChemSep v8.3 structure formula "(C6H2)(CH3)4" (derived 2026-09-03; reproduces MW to 0.003 %)
reviewStatus interim;
MW          134.2182;      // kg/kmol [origin=ChemSep v8.3]
Tc          676;      // K [origin=ChemSep v8.3]
Pc          29;      // bar; source Pa / 1e5 [origin=ChemSep v8.3]
omega       0.423;      // [-] [origin=ChemSep v8.3]
Tb          470;      // K [origin=ChemSep v8.3]

standardThermochemistry
{
    dHf_298   -45270;        // J/mol   [ChemSep v8.3, ideal gas]
    s_298     418.5;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.240917986  1693.227326  -70.102);
