/*--------------------------------*- Choupo -*-----------------------*\
  Component: Triplet methylene (ground state; C1 combustion intermediate)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "CH2", appendix D p. 81 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 14 (s_298).  The report's own sources
  for this species: D0(H2C-H): Ruscic,1999. Jacox,1998.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Transcribed 2026-10-25 by bin/curate/nasa_tp2002_to_choupo.py (DEV.md
  4c C164), which holds H and S at 298.15 K recomputed from the printed
  coefficients to the printed values; not yet read back by a curator.
\*---------------------------------------------------------------------------*/

name           CH2;
formula        CH2;
CAS            n/a;        // radical registry number: pending curation

MW             14.027;       // kg/kmol
role        nonvolatile;
tags           ( radical gasPhase combustion );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";

standardThermochemistry
{
    dHf_298    390364.517;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 81, entry CH2
    s_298      194.419;     // J/(mol·K) -- third-law absolute; Table B1, p. 14
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 81, entry CH2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 3.218921730e+04 -2.877601815e+02 4.203583820e+00 3.455405960e-03 -6.746193340e-06 7.654571640e-09 -2.870328419e-12 );
    high     ( 2.550418031e+06 -7.971625390e+03 1.228924487e+01 -1.699122922e-03 2.991728605e-07 -2.767007492e-11 1.051341740e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 81, entry CH2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 14 prints 390.365 kJ/mol; the report's own sources: D0(H2C-H): Ruscic,1999. Jacox,1998.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 14, entry CH2";
