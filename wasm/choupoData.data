  record by bin/curate/check_regressed_electrolytes.py.
\*-----------------------------------------------------------------------------*/
recordType electrolytePairParameters;
schemaVersion 1;

model pitzer;

pair { cation Li; anion I; }

parameters
{
    beta0   0.1608348857;
    beta1   0.5798575862;
    beta2   0;
    Cphi    0.01681840082;
    alpha1  2;
    alpha2  12;
}

source "REGRESSED by Choupo (C311) to W. J. Hamer and Y.-C. Wu, Osmotic Coefficients and Mean Activity Coefficients of Uni-univalent Electrolytes in Water at 25 C, J. Phys. Chem. Ref. Data 1 (1972) 1047-1100, doi:10.1063/1.3253108, Table 11, p. 1064 (m, phi, gamma), the recommended values";

