// PC-SAFT non-associating segment parameters (Gross & Sadowski, IECR 40
// (2001) 1244, Table 1 -- the pure n-alkane fit to vapour pressure + liquid
// density).  m segments, sigma [Angstrom], epsilon/k [K].
pcsaft
{
    m        2.0020;
    sigma    3.6184;
    epsilonK 208.11;
    source   "Gross & Sadowski, Ind. Eng. Chem. Res. 40 (2001) 1244, Table 1";
}
/*--------------------------------*- Choupo -*-----------------------*\
  Mineral: natron (Na2CO3:10H2O) -- unified substance file.
  One canonical record per chemical identity; the solid-phase dissolution
  equilibrium (Ksp) lives here as a typed solidPhase (roadmap Phase D).
  Migrated from chemistry/mineralSolubility/ with values preserved verbatim.
\*---------------------------------------------------------------------------*/
name natron;
formula "Na2CO3:10H2O";

solidPhases
{
    natron
    {
        dissolutionReaction { masters ( { ion HCO3; nu 1; } { ion H; nu -1; } { ion Na; nu 2; } ); nuWater 10; }
        //  No dissolution enthalpy in the source.  The dH this entry carried
        //  until 2026-11-16 (-14899.2 J/mol) was only the enthalpy of the basis
        //  conversion, which bin/curate/pitzer_minerals_to_choupo.py added to a
        //  missing value as if it were 0; removed (docs/reviews/2026-11-16-
        //  speciation-audit, GS-02).  Off 25 C the engine holds log K at its
        //  25 C value and says so.
        equilibrium { logK25 9.504; source "USGS PHREEQC pitzer.dat/phreeqc.dat (public domain); reaction re-expressed to Choupo master basis from Natron"; }
    }
}
/*--------------------------------*- Choupo -*-----------------------*\
  Component: Sodium fluoride (NaF, CAS 7681-49-4)

  A non-volatile, fully dissociating salt (Na+ + F-), added for the
  water-treatment membrane path (DEV.md 4c C157/C161/C170): a real water's
  ions each carry their transport data on their own species record
  (species/Na.dat, species/F.dat), and a salt
  is how a case FEEDS them -- the DSPM-DE pore, the multi-ionic film and the
  electrodialysis units decompose it through `dissociatesTo`.

  IDENTITY ONLY.  The record carries the name, the formula, the CAS number,
  the molar mass and the ion stoichiometry, and nothing it cannot cite: no
  thermochemistry (a dissolved salt's formation enthalpy is ION-DERIVED,
  never a component-level standardThermochemistry block -- CLAUDE.md 5), no
  solubility, no crystal and no heat capacity: each is ABSENT, never a
  zero, and curating them is a later act.
    MW  41.988 g/mol = 22.99 + 18.998, the IUPAC abridged standard
        atomic weights (Prohaska et al., Standard atomic weights of the
        elements 2021 (IUPAC Technical Report), Pure Appl. Chem. 94 (2022)
        573-600; the abridged values).
\*---------------------------------------------------------------------------*/

name           NaF;
formula        NaF;
CAS            7681-49-4;
