/*--------------------------------*- Choupo -*-----------------------*\
  Mineral: carnallite (KMgCl3:6H2O) -- unified substance file.
  One canonical record per chemical identity; the solid-phase dissolution
  equilibrium (Ksp) lives here as a typed solidPhase (roadmap Phase D).
  Migrated from chemistry/mineralSolubility/ with values preserved verbatim.
\*---------------------------------------------------------------------------*/
name carnallite;
formula "KMgCl3:6H2O";

solidPhases
{
    carnallite
    {
        dissolutionReaction { masters ( { ion K; nu 1; } { ion Mg; nu 1; } { ion Cl; nu 3; } ); nuWater 6; }
        equilibrium { logK25 4.35; dH 1170; analytic ( 24.06 -0.0311 -3090 0 0 0 ); validC ( 0 200 ); source "USGS PHREEQC pitzer.dat/phreeqc.dat (public domain); reaction re-expressed to Choupo master basis from Carnallite"; }
    }
}
/*--------------------------------*- Choupo -*-----------------------*\
  Component: R1234yf  (C3F4H2, CAS 754-12-1)
  PROPOSAL TIER -- UNVERIFIED.  Imported from CoolProp 7.2.0 (MIT);
  pure-fluid properties from the published reference EOS below.
  Reference EOS: Richter-JCED-2011
  NOTE: formation properties (dHf, s_298) and group decompositions
  are NOT provided by CoolProp -> omitted here (a gap, not fabricated).
\*---------------------------------------------------------------------------*/

name        R1234yf;

//  Review state, MACHINE-READABLE (AP2, 2026-08-05).  This used to
//  live only in the banner above, which the parser discards -- so the
//  engine could not announce it and a run said nothing.
reviewStatus   interim;
reviewReason   importedFromCoolProp720_notCheckedAgainstPrimaries;
formula     C3F4H2;
CAS         754-12-1;

MW          114.0416;        // kg/kmol  [CoolProp]
Tc          367.8500;        // K        [CoolProp EOS]
Pc          33.82245;        // bar      [CoolProp EOS]
omega       0.27600;        // [-]      [CoolProp EOS]
Tb          243.6649;        // K  normal boiling [CoolProp]
HvapTb      20555.5;        // J/mol  at Tb     [CoolProp]
Vliq        1.0444e-04;        // m3/mol @298K     [CoolProp]

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)   -- fitted to CoolProp EOS
    coefficients  (4.25047   950.406   -19.8477);
    Trange        (220.50  360.49);
}

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol.K)] = a0 + a1 T + a2 T^2 + a3 T^3   -- fitted to CoolProp cp0
    coefficients  (8.29896  0.414089  -0.000380043  1.3169e-07);
    Trange        (200  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp_liq [J/(mol.K)]   -- fitted to CoolProp saturated-liquid cp
    coefficients  (75.3607  0.18895  2.54385e-05  8.84061e-07);
    Trange        (225  244);
}

triplePoint
{
    T   220.0000;
    P   31507.5588;
}

standardThermochemistry
{
    dHf_298   -782800;      // J/mol ideal-gas -- provenance: see the structured dHf_298 block below
    dGf_298   -722730;      // J/mol  ideal-gas [Joback]
    s_298     352.024;      // J/(mol*K) third-law [DERIVED: (dHf-dGf)/T + CODATA element S]
}

groups { joback ( { group C; count 1; } { group eCH2; count 1; } { group eC; count 1; } { group F; count 4; } ); }

provenance
{
    dHf_298
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "C:1,F:4,eC:1,eCH2:1";
        uncertainty      { status unquantified; reason "bulk-import band ~9 kJ/mol, primary basis not verified"; }
    }

    constants      "CoolProp 7.2.0 -- Richter-JCED-2011";
    vaporPressure  "Antoine fitted to CoolProp EOS saturation, AAD 0.36%";
    idealGasCp     "polynomial fitted to CoolProp cp0, maxerr 0.15%";
    liquidCp       "polynomial fitted to CoolProp sat-liquid cp, maxerr 0.00%";
    triplePoint    "CoolProp reference EOS triple-point T,P";
    preserved      "from prior proposal (NOT CoolProp): standardThermochemistry, groups";
}
/*--------------------------------*- Choupo -*-----------------------*\
  Component: Methylidyne radical (prompt-NOx initiator CH + N2; C1 chain)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "CH", appendix D p. 78 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 14 (s_298).  The report's own sources
  for this species: Gurvich,1979 pt1 p37 pt2 p39.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Transcribed 2026-10-25 by bin/curate/nasa_tp2002_to_choupo.py (DEV.md
  4c C164), which holds H and S at 298.15 K recomputed from the printed
  coefficients to the printed values; not yet read back by a curator.
\*---------------------------------------------------------------------------*/

name           CH;
formula        CH;
CAS            n/a;        // radical registry number: pending curation

MW             13.019;       // kg/kmol
role        nonvolatile;
tags           ( radical gasPhase combustion );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";

standardThermochemistry
{
    dHf_298    597370.604;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 78, entry CH
    s_298      183.040;     // J/(mol·K) -- third-law absolute; Table B1, p. 14
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 78, entry CH, a1..a7 as printed.
    //  The report's 6000-20000 K interval is not transcribed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.220590133e+04 -3.405411530e+02 5.531452290e+00 -5.794964260e-03 7.969554880e-06 -4.465911590e-09 9.596338320e-13 );
    high     ( 2.060763440e+06 -5.396206660e+03 7.856293850e+00 -7.965907450e-04 1.764308305e-07 -1.976386267e-11 5.030429510e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 78, entry CH, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 14 prints 597.371 kJ/mol; the report's own sources: Gurvich,1979 pt1 p37 pt2 p39.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 14, entry CH";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 183.040";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 78, entry CH, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
