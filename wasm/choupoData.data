/*--------------------------------*- Choupo -*-----------------------*\
  Mineral: kalicinite (KHCO3) -- unified substance file.
  One canonical record per chemical identity; the solid-phase dissolution
  equilibrium (Ksp) lives here as a typed solidPhase (roadmap Phase D).
  Migrated from chemistry/mineralSolubility/ with values preserved verbatim.
\*---------------------------------------------------------------------------*/
name kalicinite;
formula "KHCO3";

solidPhases
{
    kalicinite
    {
        dissolutionReaction { masters ( { ion K; nu 1; } { ion HCO3; nu 1; } ); }
        //  No dissolution enthalpy in the source.  The dH this entry carried
        //  until 2026-11-16 (-14899.2 J/mol) was only the enthalpy of the basis
        //  conversion, which bin/curate/pitzer_minerals_to_choupo.py added to a
        //  missing value as if it were 0; removed (docs/reviews/2026-11-16-
        //  speciation-audit, GS-02).  Off 25 C the engine holds log K at its
        //  25 C value and says so.
        equilibrium { logK25 0.389; source "USGS PHREEQC pitzer.dat/phreeqc.dat (public domain); reaction re-expressed to Choupo master basis from Kalicinite"; }
    }
}
/*--------------------------------*- Choupo -*--------------------------------*\
  Component: L-Alanine (2-aminopropanoic acid), crystal (C3H7NO2).  MW 89.094 g/mol (the engine's atomic weights).

  A NON-VOLATILE crystalline organic solid: never enters the vapour (K = 0), no Antoine block.  Built on the
  citric-acid pattern (components/citricAcid.dat) from the formation data of Miller & Smith-Magowan (1990), C373 phase 3.

  WHAT THIS RECORD CARRIES, AND WHAT IT DELIBERATELY DOES NOT.

    carries   the crystal formation enthalpy dHf = -561.24 +/- 0.63 kJ/mol
              (Miller & Smith-Magowan, J. Phys. Chem. Ref. Data 19 (1990) 1049, Table 3, p. 1054, row dfH(cr) (their ref. b: Cox & Pilcher 1970, whose value is for D-alanine; Miller adopts it for the L acid, the two crystals having one enthalpy, and notes that the values for the L isomers seem to be in error in that source; read from a page image));
              the heat of solution of the pair file parameters/solution/alanine-water.dat.
    does NOT  a density, a standard entropy s_298 and any heat capacity as record values: no density is
              in a work read for this record, and Miller prints the crystal entropy only as an intermediate of
              its third-law route to the aqueous species (Table 3), which enter through the species records.  An
              energy balance that reaches the crystal's or the solution's SENSIBLE heat therefore refuses by
              the name of what is missing (CLAUDE.md rule 5).

    ALSO BUILT, in their own homes: the alanine ladder (H2Ala, HAla, Ala; chemistry/*-formation), whose zwitterion carries
              the aqueous enthalpy and entropy of Miller's Table 3.
\*---------------------------------------------------------------------------*/

name        alanine;
formula     C3H7NO2;
MW          89.094;            // kg/kmol

role        nonvolatile;               // crystalline amino acid; never to the vapour (K = 0)
dissociation 1;                 // molecular (the ions are species/, see the header)

standardThermochemistry
{
    dHf_298   -561240;        // J/mol  crystalline [-561.24 +/- 0.63 kJ/mol, Miller & Smith-Magowan 1990, Table 3]
    referenceState     pureSolid;
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "evaluated enthalpy of formation of the crystal (-561.24 +/- 0.63 kJ/mol)";
        citation      "Miller & Smith-Magowan, J. Phys. Chem. Ref. Data 19 (1990) 1049, Table 3, p. 1054, row dfH(cr) (their ref. b: Cox & Pilcher 1970, whose value is for D-alanine; Miller adopts it for the L acid, the two crystals having one enthalpy, and notes that the values for the L isomers seem to be in error in that source; read from a page image)";
    }
}
/*--------------------------------*- Choupo -*--------------------------------*\
  Component: Polypropylene (isotactic)

  A commodity polymer as a NONVOLATILE pseudo-component (Pareto over the Polymer
  Handbook): one repeat-unit molar mass + the handful of properties conceptual
  design actually uses, NOT a molecular-weight distribution and NOT segment-based
  PC-SAFT (the commercial polymer-simulator 95%, deliberately skipped).

  CURATION: representative grade values from group-contribution tables; many are
  GRADE-dependent -- isotactic; Tg spans -20..0 C with tacticity; amorphous density ~852 kg/m3. Re-source the primary for a design number.
\*-----------------------------------------------------------------------------*/

name        polypropylene;
formula     "C3H6 (-[CH2-CH(CH3)]-)";
MW          42.08;            // g/mol of the REPEAT UNIT (not the chain)


role        nonvolatile;             // a solid polymer: never in the vapour (K = 0)

polymer        // polymer-specific reference properties (glass-box; not VLE data)
{
    Tg            263;          // K, glass-transition temperature
    Tm            440;          // K, crystalline melting point
    Cp_solid      1800;          // J/(kg K) at 298 K, solid
    k_thermal     0.2;          // W/(m K)
    crystallinity 0.50-0.65;       // typical mass fraction (grade-dependent)
    provenance
    {
        Tg            { origin literature; method "Brandrup, Immergut & Grulke, Polymer Handbook, 4th ed. (Wiley, 1999)"; }
        Cp_solid      { origin literature; method "Van Krevelen & Te Nijenhuis, Properties of Polymers, 4th ed. (Elsevier, 2009)"; }
        k_thermal     { origin literature; method "Van Krevelen & Te Nijenhuis, Properties of Polymers, 4th ed. (Elsevier, 2009)"; }
        crystallinity { origin literature; method "Brandrup, Immergut & Grulke, Polymer Handbook, 4th ed. (Wiley, 1999)"; }
    }
}

// ---- solid the engine's solid slot (density feeds sizing / hold-up) ----
rho_p       905;           // kg/m3, bulk density (see grade note)
provenance
{
    rho_p { origin literature; method "Van Krevelen & Te Nijenhuis, Properties of Polymers, 4th ed. (Elsevier, 2009) (amorphous) + handbook bulk value for the named grade"; }
}


