\*---------------------------------------------------------------------------*/

name        cis13Dimethylcyclopentane;
CAS         2532-58-3;
formula     C7H14;      // counted from the ChemSep v8.3 structure formula "-CH2CH(CH3)CH2CH(CH3)CH2-" (derived 2026-09-03; reproduces MW to 0.003 %)
reviewStatus interim;
MW          98.18607;      // kg/kmol [origin=ChemSep v8.3]
Tc          551;      // K [origin=ChemSep v8.3]
Pc          34;      // bar; source Pa / 1e5 [origin=ChemSep v8.3]
omega       0.276;      // [-] [origin=ChemSep v8.3]
Tb          364.71;      // K [origin=ChemSep v8.3]

standardThermochemistry
{
    dHf_298   -135850;        // J/mol   [ChemSep v8.3, ideal gas]
    s_298     366.81;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.148413261  1337.105851  -41.512);
    Trange        (332.1  486.02);
}

Vliq        0.0001325;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      30913.1;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (86.318  -831.43  6.850244721  -0.00059782  1.8276e-07);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (65.786  -81.345  4.230244721  0.0032931  -1.3405e-06);
    Trange        (210.93  363.92);
}

liquidViscosity
{
    chemsepEq101
    {
        A     -11.311;
        B     1000.6;
        C     0.063555;
        D     -2.0388e-07;
        E     2;
        Tmin  139.45;
        Tmax  508.65;
    }
}

liquidThermalConductivity
{
    chemsepEq16
    {
        A     -0.041732;
        B     3.5995;
        C     -1.581;
        D     -0.00048911;
        E     -1.6476e-06;
        Tmin  139.45;
        Tmax  363.92;
    }
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (2 CH3 + 3 CH2 + 2 CH), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   4.7192;
    q   3.7720;
}

groups
{
    unifac ( { group CH3; count 2; } { group CH2; count 3; } { group CH; count 2; } );
}
