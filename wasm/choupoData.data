    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.138424488  1047.778867  -22.718);
    Trange        (260.65  389.49);
}

Vliq        9.6073e-05;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      22964.8;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
