  Component: pNitrotoluene  (CAS 99-99-0)
  PROPOSAL TIER -- UNVERIFIED. Imported from ChemSep v8.3
  pure-component data under Artistic License 2.0.
  Critical constants are source data; Psat is an explicitly
  estimated Ambrose-Walton corresponding-states closure.
\*---------------------------------------------------------------------------*/

name        pNitrotoluene;
CAS         99-99-0;
formula     C7H7NO2;      // counted from the ChemSep v8.3 structure formula "C6H4(NO2)(CH3)" (derived 2026-09-03; reproduces MW to 0.001 %)
reviewStatus interim;
MW          137.136;      // kg/kmol [origin=ChemSep v8.3]
Tc          736;      // K [origin=ChemSep v8.3]
Pc          38;      // bar; source Pa / 1e5 [origin=ChemSep v8.3]
omega       0.542405;      // [-] [origin=ChemSep v8.3]
Tb          511.15;      // K [origin=ChemSep v8.3]

standardThermochemistry
{
    dHf_298   31000;        // J/mol   [ChemSep v8.3, ideal gas]
    s_298     380.8;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.149716145  1774.918118  -83.592);
    Trange        (445  654.95);
}

Vliq        0.000119187;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      45559.6;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (126.83  -1053.5  7.074244721  -0.0011308  3.2272e-07);
    Trange        (273  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (90.28  945.96  -2.971855279  0.019415  -1.3352e-05);
    Trange        (324.75  557.25);
}

liquidViscosity
{
    chemsepEq101
    {
        A     -164.01;
        B     7455.2;
        C     23.73;
        D     -2.6464e-05;
        E     2;
        Tmin  320.15;
        Tmax  594.4;
