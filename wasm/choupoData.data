standardThermochemistry
{
    dHf_298   -312400;        // J/mol   [ChemSep v8.3, ideal gas]
    s_298     326.3;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.246563814  1058.679659  -105.93);
    Trange        (303.83  451.67);
}

Vliq        9.42654e-05;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      39378.4;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (65.56  -540.88  5.650244721  0.00014695  -5.2324e-08);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (-158.22  -166.8  6.260244721  0.0013959  -1.9876e-06);
    Trange        (298.15  460);
}

liquidViscosity
{
