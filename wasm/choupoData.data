/*--------------------------------*- Choupo -*--------------------------------*\
  Component: L-Aspartic acid (aminobutanedioic acid), crystal (C4H7NO4).  MW 133.103 g/mol (the engine's atomic weights).

  A NON-VOLATILE crystalline organic solid: never enters the vapour (K = 0), no Antoine block.  Built on the
  citric-acid pattern (components/citricAcid.dat) from the formation data of Miller & Smith-Magowan (1990), C373 phase 3.

  WHAT THIS RECORD CARRIES, AND WHAT IT DELIBERATELY DOES NOT.

    carries   the crystal formation enthalpy dHf = -973.32 +/- 0.92 kJ/mol
              (Miller & Smith-Magowan, J. Phys. Chem. Ref. Data 19 (1990) 1049, Table 3, p. 1054, row dfH(cr) (their ref. a: Cox & Pilcher 1970; read from a page image));
              the heat of solution of the pair file parameters/solution/asparticAcid-water.dat.
    does NOT  a density, a standard entropy s_298 and any heat capacity as record values: no density is
              in a work read for this record, and Miller prints the crystal entropy only as an intermediate of
              its third-law route to the aqueous species (Table 3), which enter through the species records.  An
              energy balance that reaches the crystal's or the solution's SENSIBLE heat therefore refuses by
              the name of what is missing (CLAUDE.md rule 5).

    ALSO BUILT, in their own homes: the asparticacid ladder (H3Asp, H2Asp, HAsp, Asp; chemistry/*-formation), whose zwitterion carries
              the aqueous enthalpy and entropy of Miller's Table 3.
\*---------------------------------------------------------------------------*/

name        asparticAcid;
formula     C4H7NO4;
MW          133.103;            // kg/kmol

role        nonvolatile;               // crystalline amino acid; never to the vapour (K = 0)
dissociation 1;                 // molecular (the ions are species/, see the header)

standardThermochemistry
{
    dHf_298   -973320;        // J/mol  crystalline [-973.32 +/- 0.92 kJ/mol, Miller & Smith-Magowan 1990, Table 3]
    referenceState     pureSolid;
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "evaluated enthalpy of formation of the crystal (-973.32 +/- 0.92 kJ/mol)";
        citation      "Miller & Smith-Magowan, J. Phys. Chem. Ref. Data 19 (1990) 1049, Table 3, p. 1054, row dfH(cr) (their ref. a: Cox & Pilcher 1970; read from a page image)";
    }
}
/*--------------------------------*- Choupo -*-----------------------*\
  Component: Benzene  (C6H6, CAS 71-43-2)
  Sources:   constants (Tc/Pc/omega/MW/Tb) + vapour pressure cross-checked
             against CoolProp 7.2.0 (MIT); ideal-gas formation enthalpy/
             entropy against the NASA polynomial database (NASA TM-4513).
             Latent heat at Tb is an individual literature value --
             primary re-citation pending (IST review).
\*---------------------------------------------------------------------------*/

name        benzene;
formula     C6H6;
CAS         71-43-2;



MW          78.114;        // kg/kmol
Tc          562.05;        // K
Pc          48.95;         // bar
omega       0.2103;        // [-]   acentric factor
Tb          353.24;        // K     normal boiling point
HvapTb      30720;         // J/mol latent heat at Tb
Vliq        8.943e-5;      // m³/mol liquid molar volume at 25 °C  (= 89.43 cm³/mol)
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 18700;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]


standardThermochemistry
{
    dHf_298   82930.0;        // J/mol  -- ideal-gas reference
    s_298     269.310;         // J/(mol·K)  -- third-law absolute
}
vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    coefficients  (4.01814   1203.835   -53.226);
    Trange        (287.7  354.07);
}

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol·K)] = a0 + a1*T + a2*T^2 + a3*T^3
    coefficients  (-31.368   0.4746   -3.117e-4   8.523e-8);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         polynomial;
    // Approximate average over 280–370 K  (individual literature value)
    coefficients  (135.4);
    Trange        (278  350);
}

// Liquid transport (v0.62+).  associationFactor = Wilke-Chang phi (solvent).
// liquidViscosity: ln(mu/Pa.s) = A + B/T (Andrade) or A + B/(T-C) (Vogel),
// fitted to literature mu(T) over ~10-100 degC.
associationFactor  1.0;
//  PREFERRED: vogel (DEV.md 4c C398 slice (b)).  Both laws were fitted to the
//  same data window (~10-100 degC); vogel is the three-parameter fit, so it
//  is the closer of the two inside it, and it is the law most cases name
//  (water: 23 case directories write Vogel, 3 Andrade; ethanol: 2 and 1).
//  It is the record's one value of the property when a case's block names
//  no model; a case word (`model Andrade;`) still pins its own law, so no
//  shipped number moves.
liquidViscosity
{
    preferred vogel;
    andrade { A -11.5804; B 1243.3; }
    vogel   { A -10.7929; B 794.4; C 63.0; }
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (6 ACH), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   3.1878;
    q   2.4000;
}

groups
{
    joback ( { group arCH; count 6; } );
    unifac ( { group ACH; count 6; } );
    unifacDortmund ( { group ACH; count 6; } );   // C408 (c): S naphthalene/toluene, Table III p. 182-183
}

// ---- Aqueous-speciation FACTS (substance-level, classifier-read) ----
// Curated fact: benzene does NOT participate in the aqueous speciation
// network.  An aromatic hydrocarbon has no ionisable proton in water at
// any pH the network describes.  It says nothing about benzene's aqueous
// behaviour in general -- its solubility is tiny and its activity
// coefficient enormous, which is why it forms a SECOND LIQUID rather than
// dissolving; that is phase behaviour, not speciation.
aqueousSpeciation  none;

