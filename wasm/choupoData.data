//  HANSEN solubility-parameter triple (DEV.md 4c C428 (b); a model's fact about
//  the pure liquid, read by `hansenMixture` and the Explorer's solvent lens).
//  Hansen 1967 thesis, Table 2.1 row 35 "Ethyl acetate", revised placements:
//  delta_d = 7.44, delta_p = 2.6, delta_h = 4.5 (cal/cm3)^0.5, x sqrt(4.184e6) = 2045.4828.
hansen
{
    dD    15218.4;        // Pa^0.5   = 7.44 (cal/cm3)^0.5, thesis Table 2.1 row 35
    dP    5318.3;        // Pa^0.5   = 2.6
