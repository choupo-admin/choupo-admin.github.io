dHsoln_provenance
{
    origin   literature;
    method   "Miller & Smith-Magowan, J. Phys. Chem. Ref. Data 19 (1990) 1049, Table 2, p. 1059, row dsolH (read from a page image): dH(soln) = 35.8 kJ/mol (their source 69WIL); dHf(cr) -810.98 +/- 0.63 kJ/mol and dHf(aq acid) -775.18 +/- 0.80 kJ/mol from the same table(s).";
