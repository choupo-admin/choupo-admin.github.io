Tb          276.02;      // K [origin=ChemSep v8.3]

standardThermochemistry
{
    dHf_298   -24310;        // J/mol   [ChemSep v8.3, ideal gas]
    s_298     287;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
