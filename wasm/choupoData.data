/*--------------------------------*- Choupo -*-----------------------*\
  Mineral: trona (Na3H(CO3)2:2H2O) -- unified substance file.
  One canonical record per chemical identity; the solid-phase dissolution
  equilibrium (Ksp) lives here as a typed solidPhase (roadmap Phase D).
  Migrated from chemistry/mineralSolubility/ with values preserved verbatim.
\*---------------------------------------------------------------------------*/
name trona;
formula "Na3H(CO3)2:2H2O";

solidPhases
{
    trona
    {
        dissolutionReaction { masters ( { ion Na; nu 3; } { ion H; nu -1; } { ion HCO3; nu 2; } ); nuWater 2; }
        //  No dissolution enthalpy in the source.  The dH this entry carried
        //  until 2026-11-16 (-29798.4 J/mol) was only the enthalpy of the basis
        //  conversion, which bin/curate/pitzer_minerals_to_choupo.py added to a
        //  missing value as if it were 0; removed (docs/reviews/2026-11-16-
        //  speciation-audit, GS-02).  Off 25 C the engine holds log K at its
        //  25 C value and says so.
        equilibrium { logK25 9.274; source "USGS PHREEQC pitzer.dat/phreeqc.dat (public domain); reaction re-expressed to Choupo master basis from Trona"; }
    }
}
/*--------------------------------*- Choupo -*-----------------------*\
  Component: Atomic carbon (gas phase; relevant in very high-T sooting flames)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "C", appendix D p. 74 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 13 (s_298).  The report's own sources
  for this species: Hf:Douglas,1955. Moore,1970b. Gordon,1999.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Re-sourced 2026-11-01 (DEV.md 4c C170 item 4) by
  bin/curate/nasa_tp2002_to_choupo.py from the NonCommercial compilation
  this record was first generated from: the report's values
  agree with the old ones to within dHf 0.5 kJ/mol, s 0.02 J/(mol K)
  and Cp 2 % (the record's own old Trange), and replace them; not yet
  read back by a curator.
\*---------------------------------------------------------------------------*/

name           C;
formula        C;
CAS            7440-44-0;

MW             12.011;       // kg/kmol
role        nonvolatile;
tags           ( radical gasPhase combustion );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";

standardThermochemistry
{
    dHf_298    716680.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 74, entry C
    s_298      158.101;     // J/(mol·K) -- third-law absolute; Table B1, p. 13
}


idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 74, entry C, a1..a7 as printed.
    //  The report's 6000-20000 K interval is not transcribed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 6.495031470e+02 -9.649010860e-01 2.504675479e+00 -1.281448025e-05 1.980133654e-08 -1.606144025e-11 5.314483411e-15 );
    high     ( -1.289136472e+05 1.719528572e+02 2.646044387e+00 -3.353068950e-04 1.742092740e-07 -2.902817829e-11 1.642182385e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 74, entry C, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 13 prints 716.68 kJ/mol; the report's own sources: Hf:Douglas,1955. Moore,1970b. Gordon,1999.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 13, entry C";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 158.101";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 74, entry C, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
