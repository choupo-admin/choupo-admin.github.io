    coefficients  (227.2421844  -0.07602346183  0.0008054275146);
    Trange        (190.4  372.11);
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (4 CH3 + 1 CH2 + 2 CH + 1 CH2O), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   6.0909;
    q   5.1680;
}

groups
{
    unifac ( { group CH3; count 4; } { group CH2; count 1; } { group CH; count 2; } { group CH2O; count 1; } );
    joback ( { group CH3; count 4; } { group CH; count 2; } { group CH2; count 2; } { group ether; count 1; } );
}

provenance
{
    uniquac
