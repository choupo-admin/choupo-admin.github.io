        C     -5.5774;
        D     0.012913;
        E     -1.8273e-05;
        Tmin  298.97;
        Tmax  404.96;
    }
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (3 CH3 + 1 C + 1 OH), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   3.9228;
    q   3.7440;
}

groups
{
    unifac ( { group CH3; count 3; } { group C; count 1; } { group OH; count 1; } );
    unifacDortmund ( { group CH3; count 3; } { group C; count 1; } { group OH_t; count 1; } );   // C408 (c): P tert-butanol, Table III p. 182-183
}
solubilityParameter 21620;   // Pa^0.5  [ANCHOR, ChemSep v8.3 -- checked against, never used]

source
