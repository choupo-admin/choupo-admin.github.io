/*--------------------------------*- Choupo -*-----------------------*\
  Component: Dicarbon monoxide radical (ketenyl decomposition)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "C2O", appendix D p. 93 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 16 (s_298).  The report's own sources
  for this species: Hf:Gurvich,1991 pt1 p31. Jacox,1998.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Re-sourced 2026-11-12 (DEV.md 4c C335) by
  bin/curate/nasa_tp2002_to_choupo.py from the NonCommercial compilation
  this record was first generated from (its old numbers
  are not kept here: they were that compilation's); not yet read back by
  a curator.
  THE OLD VALUE AND THE REPORT DISAGREE, and the report's is the older
  number: the report prints dHf_298 = 291.04 kJ/mol (from Gurvich 1991),
  about 88 kJ/mol below the value the record held, and modern network
  determinations sit near the old value.  The report is the only
  redistributable source in hand, so its value stands here, marked interim with that reason; a
  curator with a clean modern primary should replace it.  No shipped case
  reads this record (measured 2026-11-12).
\*---------------------------------------------------------------------------*/

name           C2O;
formula        C2O;
CAS            n/a;        // radical registry number: pending curation

MW             40.021;       // kg/kmol
role        nonvolatile;
tags           ( radical gasPhase combustion );
reviewStatus   interim;
reviewReason   "NASA/TP-2002-211556's dHf_298 (291.04 kJ/mol, Gurvich 1991) is about 88 kJ/mol below the value this record held and below modern network determinations; the report's value is kept as the only redistributable one in hand -- replace it from a clean modern primary";

standardThermochemistry
{
    dHf_298    291038.666;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 93, entry C2O
    s_298      233.624;     // J/(mol·K) -- third-law absolute; Table B1, p. 16
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 93, entry C2O, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -3.959929420e+03 -1.117516348e+02 4.593960060e+00 3.710602020e-03 -7.014760180e-07 -1.371129839e-09 7.123854000e-13 );
    high     ( -6.348056590e+05 1.184133091e+03 4.879173340e+00 1.757538773e-03 -3.957552270e-07 3.989179940e-11 -1.546043135e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 93, entry C2O, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 16 prints 291.039 kJ/mol; the report's own sources: Hf:Gurvich,1991 pt1 p31. Jacox,1998.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 16, entry C2O";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 233.624";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 93, entry C2O, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
/*--------------------------------*- Choupo -*-----------------------*\
  Component: Calcium carbonate (CaCO3), CALCITE polymorph.  CAS 471-34-1.

  A NON-VOLATILE crystalline mineral solid: it never enters the vapour
  (K = 0) and carries no Antoine / liquid-Cp blocks.  The canonical solid
  for limestone / precipitated-CaCO3 (PCC) exercises -- a scaling / anti-
  scaling species in membrane and evaporator cases, and a feed solid for
  calcination (CaCO3 -> CaO + CO2) Gibbs-reactor exercises.

  Carries a REAL solid heat capacity (solidHeatCapacity{}) and the solid-
  phase formation datum, so its sensible heat and its reaction heat both
  emerge from the elements reference like any other species.

  rho_p for calcite ~ 2710 kg/m^3.
  Sources: solid formation datum from CODATA Key Values (Cox, Wagman &
           Medvedev 1989), cross-checked vs Robie & Hemingway, USGS Bull.
           2131 (1995); solidHeatCapacity fitted to Robie & Hemingway 1995
           (public domain); rho_p 2710 kg/m^3 = calcite crystallographic
           density (public).
\*---------------------------------------------------------------------------*/

name        CaCO3;
formula     CaCO3;
CAS         471-34-1;

MW          100.0869;          // kg/kmol  (calcite)

role        nonvolatile;       // never goes to the vapour (K = 0)

solid
{
    rho_p   2710.0;            // calcite particle density [kg/m^3]
}

// Solid-phase formation datum (calcite).  PRIMARY: CODATA Key Values for
// Thermodynamics (Cox, Wagman & Medvedev 1989); cross-checked vs Robie &
// Hemingway, USGS Bull. 2131 (1995).  Both are open / public-domain sources.
standardThermochemistry
{
    dHf_298   -1207600;        // J/mol  calcite [CODATA Key Values 1989; xcheck Robie-Hemingway 1995]
    s_298     91.7;            // J/(mol*K) third-law absolute [CODATA Key Values 1989]
    referenceState     pureSolid;
}

// REAL solid heat capacity of calcite.  Cp(298.15) ~ 83.5 J/(mol*K), rising
// to ~110.9 at 600 K.  PRIMARY: Robie & Hemingway, "Thermodynamic Properties
// of Minerals and Related Substances ...", U.S. Geological Survey Bulletin
// 2131 (1995) -- a U.S. Government work, PUBLIC DOMAIN.  Quadratic least-
// squares fit to their tabulated Cp at 298.15/400/500/600 K (AAD < 0.3 %).
solidHeatCapacity
{
    model         polynomial;          // Cp = a0 + a1*T + a2*T^2  [J/(mol*K)]
    coefficients  ( 29.8993   0.224617   -1.49637e-04 );
    Trange        ( 298  600 );        // [Robie-Hemingway 1995, USGS Bull. 2131]
}

// Solid phase(s) of this component (roadmap Phase D fold-in):
solidPhases
{
    aragonite
    {
        dissolutionReaction { masters ( { ion Ca; nu 1; } { ion HCO3; nu 1; } { ion H; nu -1; } ); }
        equilibrium { logK25 1.993; dH -25731.6; analytic ( -64.0902 -0.04546451 -2248.497 32.66939 563713.9 ); source "USGS PHREEQC phreeqc.dat (public domain)"; }
    }
    calcite
    {
        dissolutionReaction { masters ( { ion Ca; nu 1; } { ion HCO3; nu 1; } { ion H; nu -1; } ); }
        //  Plummer & Busenberg (1982), Geochim. Cosmochim. Acta 46, 1011:
        //  log Ksp(CaCO3 = Ca+2 + CO3-2) = -171.9065 - 0.077993 T + 2839.319/T
        //  + 71.595 log10 T, 0-90 C, = -8.480 at 25 C; dH -2.297 kcal/mol.
        //  Rebased to the HCO3 master exactly as aragonite above (the
        //  record's HCO3 formation: +10.3291, -14899.2 J/mol).  Until
        //  2026-11-16 this entry carried -8.45 (logK25 1.879, a different
        //  fit from a revised database release) under this same citation;
        //  Vitor's ruling the same day restored the cited source's value
        //  (docs/reviews/2026-11-16-speciation-audit, SP-01/GS-01).
        equilibrium { logK25 1.849; dH -24509.8; analytic ( -64.0194 -0.04546451 -2312.471 32.66939 563713.9 ); validC ( 0 90 ); source "Plummer and Busenberg, Geochim. Cosmochim. Acta 46 (1982) 1011 (log Ksp -8.480 at 25 C, 0 - 90 C), rebased to HCO3; the same equation is in USGS PHREEQC phreeqc.dat (public domain)"; }
    }
}
