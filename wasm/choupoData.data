/*--------------------------------*- Choupo -*-----------------------*\
  CH4 gas-liquid transfer, PHREEQC molal convention (anchored analytic):
  a(CH4,aq) = K(T) * p[atm].
\*---------------------------------------------------------------------------*/
recordType gasLiquidEquilibrium;
schemaVersion 1;

// Equilibrium-parameterisation identity (ADR 2026-07-26): typed physical
// family + versioned convention profile.  The Sander H_xp pair
// parameters/Henry/CH4-water.dat is an INDEPENDENT PRIMARY of the same
// family (this analytic carries the wider T domain, lit. 25 - 100 C) --
// the cross-convention gate compares them as a curation DIAGNOSTIC,
// never as an automatic error.
gasSpecies       CH4;
dissolvedSpecies CH4;
solvent          water;
convention       PHREEQC-gasMolal-v1;

reaction "CH4(g) = CH4";
      logK25 -2.8; analytic ( 10.44 -0.00765 -6669 0 1014000 ); source "USGS PHREEQC phreeqc.dat (public domain); lit: CH4 solubilities 25 - 100 C";
/*--------------------------------*- Choupo -*--------------------------------*\
  chemistry/H2AsO4-formation.dat -- the first dissociation of arsenic acid, written from the master:
      H3AsO4  <=>  H2AsO4 + H+
  Made by bin/curate/species_c373.py from data/curation/batches/species_c373/*.tsv.

  logK25 and dH are the PRINTED values of the sources below (standard state ideal solution at 1 mol/kg, 298.15 K):
      pK1 = 2.31, dH1 = -7.8 kJ/mol (grade CC)
      pK2 = 7.05, dH2 = 1.7 kJ/mol (grade CC)
      pK3 = 11.9, dH3 = 15.9 kJ/mol (grade CC)
  Source: Goldberg, Kishore & Lennen, J. Phys. Chem. Ref. Data 31 (2002) 231; standard state: hypothetical ideal solution of unit molality, 298.15 K, 0.1 MPa (Section 8, p. 359).
  This record carries the first step (the sign flips with the direction written).
  The constant-dCp term of the printed dCp is NOT carried: the record grammar has no place for it (a
  van't Hoff integral with a constant dCp is exactly the `analytic` A1, A3, A4 terms; proposed, not done).
  dCp is not printed for arsenic acid.  The existing species H2AsO4 and HAsO4 carry NBS formation data (C320) and the new records are written from the neutral master H3AsO4.
\*-----------------------------------------------------------------------------*/
recordType aqueousSpeciation;
schemaVersion 1;

species H2AsO4; masters ( { ion H3AsO4; nu 1; } { ion H; nu -1; } );
      logK25 -2.31; dH -7800; source "Goldberg, Kishore & Lennen, J. Phys. Chem. Ref. Data 31 (2002) 231 -- Section 8 summary, p. 359, and Section 7.9, p. 248: pK1 2.31, dH1 -7.8 kJ/mol (pK, dH_ion at 298.15 K)";
recordType aqueousSpeciation;
schemaVersion 1;

// Borate from its masters (catalogue formation convention): boric acid is the
// master of boron (SOLUTION_MASTER_SPECIES  B  H3BO3), so
//     H3BO3 + H2O = BOH4 + H+,   logK25 = -pKa = -9.24,   dH = +3.224 kcal/mol.
// The databank writes the same equilibrium as  H3BO3 = H2BO3- + H+  (its borate
// is B(OH)4- less one water); the water has unit activity here, so the constant
// is identical.  The databank states NO primary for this line (read 2026-11-02,
// phreeqc3/database/phreeqc.dat lines 319-321) and NO validity window: it is
// recorded as such, never completed from memory.  This is a THERMODYNAMIC
// (infinite-dilution) constant: in seawater it must be paired with the case's
// declared aqueous activity model, never with a conditional seawater constant.
species BOH4; masters ( { ion H3BO3; nu 1; } { ion H; nu -1; } ); nuWater 1;
      logK25 -9.24; dH 13489.2; source "USGS PHREEQC phreeqc.dat (public domain): H3BO3 = H2BO3- + H+, log_k -9.24, delta_h 3.224 kcal; primary and temperature window not stated in db";
