    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (1.952  0.51874  -2.818000e-04  5.760000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
