/*--------------------------------*- Choupo -*-----------------------*\
  Henry's-law constant for 2Pentanone in liquid water (infinite dilution).

  Source DATA: Sander, R. (2015) "Compilation of Henry's law constants
  (version 4.0) for water as solvent," Atmos. Chem. Phys. 15, 4399-4981,
  doi:10.5194/acp-15-4399-2015, Table 6, p. 4538.  Licensed CC-BY 3.0.

  CHANGES (indicated per CC-BY): the 12 Table 6 rows of types M
  (measured) and L (literature) were reduced to their MEDIAN Hcp
  = 0.105 mol/(m3 Pa) at 298.15 K (the PDF prints 2 significant
  figures; row range 0.064 to 0.17, spread max/min 2.66) and converted to
  the mole-fraction constant H_ref = 55345 / Hcp [Pa] (55345 mol/m3 = water
  at 298.15 K).  The temperature coefficient is the median of the 3
  d ln Hcp / d(1/T) values those rows carry (4800 K), so
  enthalpy = -R * (4800 K) = -39909 J/mol.  Rows of types Q (QSPR),
  E (estimates), V, T, X, C, ? and W are EXCLUDED.  Reproduce with
  bin/curate/henry_sander.py (rows: data/curation/batches/henry_sander/rows.tsv).
  A literature median, not a fit; not read by a human.

  NOTE: INFINITE-DILUTION coefficient -- for water-miscible species it is
  only the dilute limit; prefer an activity-coefficient model for the full
  composition range.  Validity ~273-373 K (linear Henry form).
\*---------------------------------------------------------------------------*/

solute      2Pentanone;
solvent     water;

gasSpecies        2Pentanone;
dissolvedSpecies  2Pentanone;
convention        Sander-Hxp-v1;

model       vantHoff;
H_ref       5.2710e+05 Pa;
T_ref       298.15 K;
enthalpy    -39909  J/mol;
Trange      ( 273  373 );

reviewStatus autoPromoted;
review      { by none; }

provenance
{
    origin        literature;
    source        "Sander 2015, ACP 15, 4399, doi:10.5194/acp-15-4399-2015, Table 6, p. 4538; CC-BY 3.0";
    method        "median of 12 rows of types M and L, Sander 2015 Table 6";
    CAS           107-87-9;
    rowsUsed      12;
    rowTypes      "M L";
    excluded      "Q (QSPR) E (estimate) V T X C ? W";
    hcpMedian     0.105;   // mol/(m3 Pa), 2 significant figures as printed
    spread        2.66;   // max/min of the rows used
    dlnHrows      3;
    rowsFile      "data/curation/batches/henry_sander/rows.tsv";
}
/*---------------------------------------------------------------------------*\
  NITROGEN dissolved in liquid AMMONIA -- full Krichevsky-Kasarnovsky form.
  =======================================================================
  Same rigorous formulation as H2-NH3 (see that file for the derivation):
      y phi_V P  =  x gamma2* H(T) exp[ v_inf (P - Ps_NH3) / RT ].

  Source DATA: Larson & Black (1925), Ind. Eng. Chem. 17, 715 (DOI
  10.1021/ie50187a028) -- the 3:1 H2:N2 syngas mix in liquid NH3 at 248-295 K,
  5.07/10.13/15.20 MPa -- as compiled with BOTH gases' liquid mole fractions by
  C. L. Young, IUPAC Solubility Data Series Vol 5/6 p. 634.  The evaluation
  confirms the two gases dissolve INDEPENDENTLY (linear in partial pressure).

  FIT (KK): the 273.2 K rows at 5.07 vs 10.13 MPa give the Poynting slope
  directly: v_inf = 23 cm^3/mol (the "5% drift of H with P" IS the Poynting);
  back-extrapolated intercepts H(273) = 1.28e9, H(292) = 9.34e8 Pa; van't Hoff
  between them: dH_diss = +11040 J/mol; H_ref(298.15) = 8.5e8 Pa.
  margulesA = 0 (x_N2 < 0.3% throughout -- rigorously dilute).
  REFINEMENT HOOK: Wiebe & Tremearne (1933), JACS 55, 975 (DOI
  10.1021/ja01330a016) has direct N2-only isotherms when it lands in
  Literature.
\*---------------------------------------------------------------------------*/
solute      N2;
solvent     NH3;

// Equilibrium-parameterisation identity (ADR 2026-07-26, D2 migration wave):
// typed physical family + versioned convention profile.  Identity only --
// no coefficient or domain touched.
gasSpecies        N2;
dissolvedSpecies  N2;
convention        Sander-Hxp-v1;
model       vantHoff;
H_ref       8.5e8 Pa;             // infinite-dilution reference fugacity, 298.15 K
T_ref       298.15 K;
enthalpy    11040 J/mol;          // dH_diss > 0: more soluble hot
v_inf       2.3e-5;               // m^3/mol -- KK Poynting (23 cm^3/mol, fitted)
margulesA   0.0;                  // J/mol   -- KI gamma2* (x_N2 < 0.3%, dilute)
Trange      ( 238  305 );   // data 248-295 K +-10 K margin -- beyond = EXTRAPOLATION (announced)
/*--------------------------------*- Choupo -*-----------------------*\
  Henry's-law constant for R115 in liquid water (infinite dilution).

  Source DATA: Sander, R. (2015) "Compilation of Henry's law constants
