        E     0;
        Tmin  276.51;
        Tmax  342.82;
    }
}

surfaceTension
{
    A     0.04575792011;
    B     0;
    Tc    513.92;
    n     0.8696437677;
    Tmin  274.77;
    Tmax  333.2;
}

//  HANSEN solubility-parameter triple (DEV.md 4c C428 (b); a model's fact about
//  the pure liquid, read by `hansenMixture` and the Explorer's solvent lens).
//  Hansen 1967 thesis, Table 2.1 row 3 "Ethanol 99.9%", revised placements:
//  delta_d = 7.73, delta_p = 4.3, delta_h = 9.5 (cal/cm3)^0.5, x sqrt(4.184e6) = 2045.4828.
hansen
{
    dD    15811.6;        // Pa^0.5   = 7.73 (cal/cm3)^0.5, thesis Table 2.1 row 3
    dP    8795.6;        // Pa^0.5   = 4.3
    dH    19432.1;        // Pa^0.5   = 9.5
    Tref  298.15 K;       // adopted: the thesis prints no temperature beside Table 2.1
}

provenance
{
    hansen
    {
        origin        literature;
        method        "Hansen 1967 thesis, Table 2.1 row 3 (Ethanol 99.9%), revised placements; (cal/cm3)^0.5 x 2045.4828 -> Pa^0.5";
        citation      "Hansen, C. M., The Three Dimensional Solubility Parameter and Solvent Diffusion Coefficient, doctoral dissertation, Danish Technical Press, Copenhagen (1967), Table 2.1 (pages 18-19), row 3; no DOI";
        reviewStatus  interim;
        notes         "transcribed from the page image 2026-10-21; Tref 298.15 K adopted, the thesis states no temperature beside the table";
    }
    liquidThermalConductivity
    {
        origin        fitted;
        method        "least squares on ln y of ln(k/(W/m/K)) = C + B/T + D T (chemsepEq16 with A = 0, E = 0), 3 parameter(s), then the largest relative error minimised; every laboratory the archive holds for the pure liquid at <= 200 kPa; points beyond 15 % after the first stage discarded by name";
        fittedBy      "bin/curate/transport_fit.py";
        reviewStatus  autoPromoted;
