{
    dHf_298   -258110;      // J/mol ideal-gas -- provenance: see the structured dHf_298 block below
    dGf_298   -122200;      // J/mol  ideal-gas [Joback]
    s_298     323.091;      // J/(mol*K) third-law [DERIVED: (dHf-dGf)/T + CODATA element S]
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (2 CH3 + 1 CH2 + 1 CH2O), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   3.3949;
    q   3.0160;
}

groups
{
    joback ( { group CH3; count 2; } { group CH2; count 2; } { group ether; count 1; } );
    unifac ( { group CH3; count 2; } { group CH2; count 1; } { group CH2O; count 1; } );
    unifacDortmund ( { group CH3; count 2; } { group CH2; count 1; } { group CH2O; count 1; } );   // C408 (c): P diethyl ether, Table III p. 182-183
}
