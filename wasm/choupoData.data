gasSpecies        R141b;
dissolvedSpecies  R141b;
convention        Sander-Hxp-v1;

model       vantHoff;
H_ref       4.1426e+08 Pa;
T_ref       298.15 K;
enthalpy    -28773  J/mol;
Trange      ( 273  373 );
