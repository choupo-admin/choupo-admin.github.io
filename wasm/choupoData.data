/*--------------------------------*- Choupo -*-----------------------*\
  Component: Magnesium sulphate (MgSO4, CAS 7487-88-9)

  Divalent 1-1 electrolyte (Mg²⁺ + SO₄²⁻) --- a useful contrast to
  NaCl for NF-membrane screening, since NF preferentially rejects
  divalent ions over monovalent ones.  The ideal van't Hoff factor
  is 2 (one cation + one anion), the same as NaCl, but NF rejection
  is substantially higher because of the divalent charge --- a
  point membrane data captures through the per-component
  permeability B_s rather than through bulk thermo.
  Sources: only MW (standard atomic weights) and the dissociation
           stoichiometry are stored here.  The per-ion formation tier
           (Mg+2, SO4-2) is to be sourced from Wagman et al., NBS Tables
           (1982) -- flagged follow-up in the body; until curated, MgSO4
           stays dissolved-only (NF rejection via the membrane B_s).
\*---------------------------------------------------------------------------*/

name           MgSO4;
formula        MgSO4;
CAS            7487-88-9;

MW             120.37;         // g/mol
role        nonvolatile;

// APPARENT COMPONENT view -- the balance/representation map (apparent -> ions),
// added 2026-10-26 (DEV.md 4c C161/C170) so the DSPM-DE pore, the multi-ionic
// film and the electrodialysis units can decompose this salt into its ions,
// whose transport data live on their own species records.  The van't Hoff
// factor DERIVES from it (Component.cpp); no `dissociation` key beside it.
// The map is identity, not thermochemistry: it adds no formation datum.
dissociatesTo  { Mg 1; SO4 1; }   // ion stoichiometry (formula-like identity)

// FORMATION DATUM -- NOT in this file by design (arity-2 electrolyte).
// MgSO4 is a strong electrolyte: its thermodynamics live PER ION in the
// aqueous infinite-dilution tier, species/aqueous/ (H+(aq)=0 convention),
// referenced BY NAME -- the salt is never given a component-level
// standardThermochemistry block (see docs/ai/data-doctrine.md sec.2).
//   cation Mg   -> species/aqueous/ (z = +2)
//   anion  SO4  -> species/aqueous/ (z = -2)
// FLAGGED follow-up (do NOT fabricate): in ions.dat both Mg+2 and SO4-2
// currently carry the ION-TRANSPORT tier (radius, D0) but NOT the aqueous
// infinite-dilution ENTHALPY tier (hfAq/sAq/cpAq).  Source those from
// Wagman et al. NBS Tables (1982) -- Mg+2 ~ -466.85, SO4-2 ~ -909.27 kJ/mol --
// before any MgSO4 energy/heat-of-solution balance is run.  Until then this
// solute is dissolved-only for NF rejection (captured via the membrane B_s,
// not bulk thermo), and no energy balance consumes a MgSO4 formation number.
/*--------------------------------*- Choupo -*-----------------------*\
  Component: ethylOctanoate  (ethyl octanoate; CAS 106-32-1)
  NEW in the catalogue (DEV.md 4c C287, 2026-11-10), built by
  bin/curate/c287_new_components.py from measurements the NIST/TRC ThermoML Archive
  locates (the articles are the sources; their DOIs are in provenance).
  MEASURED: Tc, Pc.  FITTED: vapour pressure (bin/choupo-curate vp),
  Vliq, liquid Cp.  DERIVED: omega (from the fitted vapour pressure).
  ESTIMATED (Joback): ideal-gas Cp, dHf_298; s_298 derived from Joback's
  dHf and dGf.  No measured series is reproduced here.
  reviewStatus autoPromoted, humanReviewed false: NO human has read it back.
  Psat: fitted by `bin/choupo-curate vp`; its promotion replaced the
  AmbroseWalton block this tool writes (provenance.vaporPressure).
\*---------------------------------------------------------------------------*/

name        ethylOctanoate;
CAS         106-32-1;
formula     C10H20O2;
reviewStatus autoPromoted;
humanReviewed false;
MW          172.2680;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          655.74;      // K, measured (provenance.Tc)
Pc          21.592;      // bar, measured (provenance.Pc)
omega       0.597419;      // [-] (provenance.omega)
//  Tb: NOT DECLARED -- the archive reports no boiling temperature at
//  101.3 kPa for it, and a Tb read back off the fitted Antoine would be
//  the curve tested against itself (the fitted normal boiling point is
//  in provenance.vaporPressure.acceptance.Tnb_fit).

standardThermochemistry
{
    dHf_298   -567010;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     596.82;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (4.289282986  1723.641547  -80.39617183);
    Trange        (273.26  452.3);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        1.993934e-04;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (19.207  0.89904  -4.256000e-04  5.070000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, FITTED (provenance.liquidHeatCapacity)
    coefficients  (325.7271109  -0.3268358727  0.001285120925);
    Trange        (285.01  353.6);
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (2 CH3 + 6 CH2 + 1 CH2COO), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   7.5250;
    q   6.3560;
}

groups
{
    unifac ( { group CH3; count 2; } { group CH2; count 6; } { group CH2COO; count 1; } );
    joback ( { group CH3; count 2; } { group CH2; count 7; } { group ester; count 1; } );
}

