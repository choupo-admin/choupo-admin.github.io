      f/(RT) = alpha0 + alphar,  delta = rho/rho_c,  tau = T_c/T
      alpha0 = ln delta + n1 + n2 tau + n3 ln tau + sum_{4..8} n_i ln(1 - exp(-gamma_i tau))
      alphar = sum_{1..7}   n delta^d tau^t
             + sum_{8..51}  n delta^d tau^t exp(-delta^c)
