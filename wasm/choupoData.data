  PROPOSAL TIER -- UNVERIFIED. Imported from ChemSep v8.3
  pure-component data under Artistic License 2.0.
  Critical constants are source data; Psat is an explicitly
  estimated Ambrose-Walton corresponding-states closure.
\*---------------------------------------------------------------------------*/

name        3Methylheptane;
CAS         589-81-1;
formula     C8H18;      // counted from the ChemSep v8.3 structure formula "CH3CH2CH(CH3)(CH2)3CH3" (derived 2026-09-03; reproduces MW to 0.003 %)
reviewStatus interim;
MW          114.2285;      // kg/kmol [origin=ChemSep v8.3]
Tc          563.6;      // K [origin=ChemSep v8.3]
Pc          25.5;      // bar; source Pa / 1e5 [origin=ChemSep v8.3]
omega       0.371;      // [-] [origin=ChemSep v8.3]
Tb          392.08;      // K [origin=ChemSep v8.3]

standardThermochemistry
{
    dHf_298   -212510;        // J/mol   [ChemSep v8.3, ideal gas]
    s_298     465.51;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.104983813  1384.878244  -54.285);
    Trange        (342.54  506);
}

Vliq        0.000162685;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      33619.4;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (103.08  -583.42  6.363244721  5.2348e-05  -2.126e-08);
    Trange        (150  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (137.93  50.329  2.995044721  0.0059467  -2.4618e-06);
    Trange        (107.25  500);
}

liquidViscosity
{
    chemsepEq101
    {
        A     -7.3817;
        B     976.23;
        C     -0.66335;
        D     2.1183e-06;
        E     2;
        Tmin  152.6;
        Tmax  450.88;
    }
}

liquidThermalConductivity
{
    chemsepEq16
    {
        A     -0.043161;
        B     22.706;
        C     -1.6829;
        D     -6.3735e-05;
        E     -2.0484e-06;
        Tmin  152.6;
        Tmax  503.15;
    }
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (3 CH3 + 4 CH2 + 1 CH), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   5.8478;
    q   4.9320;
