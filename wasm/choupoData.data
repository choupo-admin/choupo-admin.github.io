}
/*--------------------------------*- Choupo -*-----------------------*\
  Solution properties: SODIUM HYDROXIDE dissolved in liquid WATER -- the
  solution's own DENSITY law (DEV.md 4c C378 pilot; the plan's section 4,
  docs/design/density-pilot-plan.md).

  A solution's density is a property of the constituent SET {NaOH, water},
  not of either component: it lives here, in the solution tier, named by the
  set sorted case-insensitively.  The liquid-density kernel
  (src/thermo/liquidProperty/SolutionLaw) reads it for a liquid whose
  constituents are exactly NaOH and water, whatever activity model the case
  chooses.  It is NOT the coefficient record of the activity model
  `OlssonNaOH` (parameters/OlssonNaOH/NaOH-water.dat), which carries the
  same paper's vapour pressure and enthalpy for that model alone: two
  records of two kinds for one set, by ruling (DEV.md 4c, C378 "the pilot's
  plan is written and ruled").

  This file carries no heat of solution (`dHsoln`): the paper gives none in
  this form, so the enthalpy tier (SolutionRegistry) does not register it.

  How the numbers were read: the 18 coefficients of Table IV and the six
  bands of Table III were read off the PAGE IMAGES of the paper (150 dpi
  page, 300 dpi crop, twice; docs/design/naoh-water-olsson1997.md 1.2) and
  checked digit by digit against the page image of p. 785 a second time for
  the pilot's thresholds (docs/design/density-pilot-thresholds.md 3.3): all
  agree.

  Variables, AS THE PAPER WRITES THEM (nomenclature pp. 792-793): x is the
  mass fraction of WATER [kg water / kg solution], t the temperature in
  degC; rho in kg/m3.  The paper's b1, b2, b3 of Eq. (6) are the rows below;
  its Table IV columns k_rho, l_rho, m_rho give them, i = 0..5 the
  coefficients of x^(i/2) (Eqs. 7-9).

  Licence of the numbers: the coefficients of a published correlation are
  facts, cited to their paper.
\*---------------------------------------------------------------------------*/

solute      NaOH;
solvent     water;

liquidDensity
{
    returns           solutionDensity;     // kg/m3 of the solution
    form              polynomialTSqrtX;    // rho = b1 + b2 t + b3 t^2, b_j = sum_i c_ji x^(i/2)
    variable          w[water];            // kg water / kg solution (the paper's x)
    temperatureOrigin 273.15 K;            // t = T - 273.15 K: the paper writes t in degC

    //  Table IV, p. 785 (Eqs. 7-9): x^0, x^(1/2), x^1, x^(3/2), x^2, x^(5/2)
    b1 ( 5007.2279636  -25131.164248  74107.692582  -104657.48684  69821.773186  -18145.911810 );
    b2 ( -64.786269079  525.34360564  -1608.4471903  2350.9753235  -1660.9035108  457.64374355 );
    b3 ( 0.24436776978  -1.9737722344  6.04601497138  -8.9090614947  6.37146769397  -1.7816083111 );

    //  Table III, p. 783: the lowest water fraction per temperature band
    //  (the law holds from there to pure water).  T in K, raw SI (a list
    //  carries no unit suffix in this grammar; the unit is this comment).
    domain
    (
        { T ( 273.15 283.15 ); w[water] ( 0.800 1 ); }
        { T ( 283.15 293.15 ); w[water] ( 0.700 1 ); }
        { T ( 293.15 333.15 ); w[water] ( 0.500 1 ); }
        { T ( 333.15 343.15 ); w[water] ( 0.400 1 ); }
        { T ( 343.15 423.15 ); w[water] ( 0.300 1 ); }
        { T ( 423.15 473.15 ); w[water] ( 0.200 1 ); }
    );

    //  No P in Eqs. (6)-(9); the data the law was fitted to are near
    //  atmospheric.  Against the 2-10 MPa set of Hnedkovsky et al. (2007)
    //  the law is 0.12 % low at 2 MPa and 0.45 % low at 10 MPa (the pilot's
    //  thresholds note 3.3): the run says "no pressure term" once per unit.
    pressure          notCarried;

    provenance
    {
        origin        literature;
        citation      "J. Olsson, A. Jernqvist and G. Aly, Int. J. Thermophys. 18 (1997) 779-793, Eqs. (6)-(9) p. 785, Table IV p. 785, Table III p. 783";
        uncertainty   "in sample: 156 points of Krey (1972), mean 0.48 kg/m3 (0.04 %), max 2.41 kg/m3 (0.23 %), pp. 785-786; out of sample: Galindo-Luna et al. 2019 (186 points, 303-353 K, 0.1 MPa) AAD 0.055 %, max 0.206 % (docs/design/density-pilot-thresholds.md 3.3)";
        maxDeviation  2.41 kg/m3;          // the number a disagreement is counted against
        read          "page images, 150 and 300 dpi, twice (docs/design/naoh-water-olsson1997.md 1.2)";
    }
}
/*--------------------------------*- Choupo -*--------------------------------*\
  Edwards (1978) molecule-ion interaction parameter, CO2 - H.

  Role: the molecule-ion (SALTING-OUT) beta(0) of Table 6, temperature-independent.

  beta1 is NOT stored: for any pair involving a MOLECULAR species the paper
  sets beta1 = 0 ("because experimental data are inadequate").

  Table 6 is headed "for 0 to 170 degC" and its polynomials are written in
  T.  **T IS KELVIN.**  The paper settles this itself: Table 7's column II
  publishes beta0(NH3,NH4+) = 1/2 beta0(NH3,NH3) + 1/2 beta0(CO2,NH4+)
  - 1/2 beta0(CO2,CO2) = 0.051 at 100 degC, which evaluates to 0.0504 in
  kelvin and 0.0582 in Celsius.  The degC in the header is the range of
  validity, exactly as in Tables 1 and 3.
\*-----------------------------------------------------------------------------*/
recordType    electrolytePairParameters;
schemaVersion 1;

model         edwardsPitzer;
convention    Edwards-Hkgatm-v1;

pair { molecule CO2aq; ion H; }

parameters
{
    beta0  +0.033;   // kg/mol, T-independent
}

Trange ( 273.15 443.15 );   // 0-170 degC

source "Edwards, Maurer, Newman & Prausnitz, AIChE J. 24(6):966-976 (1978), Table 6";
/*--------------------------------*- Choupo -*--------------------------------*\
  Edwards (1978) molecule-ion interaction parameter, CO2 - HS.

  Role: the molecule-ion (SALTING-OUT) beta(0) of Table 6, temperature-independent.

  beta1 is NOT stored: for any pair involving a MOLECULAR species the paper
  sets beta1 = 0 ("because experimental data are inadequate").

  Table 6 is headed "for 0 to 170 degC" and its polynomials are written in
  T.  **T IS KELVIN.**  The paper settles this itself: Table 7's column II
  publishes beta0(NH3,NH4+) = 1/2 beta0(NH3,NH3) + 1/2 beta0(CO2,NH4+)
  - 1/2 beta0(CO2,CO2) = 0.051 at 100 degC, which evaluates to 0.0504 in
  kelvin and 0.0582 in Celsius.  The degC in the header is the range of
  validity, exactly as in Tables 1 and 3.

  THE ZERO IS A DATUM.  Table 6 TABULATES 0 for this pair; without this
  record the engine would derive a NONZERO estimate by Eq 23 and announce
  it as estimated.  Running the estimate where the paper tabulates a value
  would knowingly diverge from the source, so the tabulated zero is
  curated exactly like any other tabulated number.
\*-----------------------------------------------------------------------------*/
recordType    electrolytePairParameters;
schemaVersion 1;

model         edwardsPitzer;
convention    Edwards-Hkgatm-v1;

pair { molecule CO2aq; ion HS; }

parameters
{
    beta0  +0;   // kg/mol, T-independent
}

Trange ( 273.15 443.15 );   // 0-170 degC

source "Edwards, Maurer, Newman & Prausnitz, AIChE J. 24(6):966-976 (1978), Table 6";
/*--------------------------------*- Choupo -*--------------------------------*\
  Henry's constant for NH3 in water -- the EDWARDS (1978) parameterisation.

  THIS IS NOT A REPLACEMENT for parameters/Henry/NH3-water.dat, which
  carries the Sander-Hxp-v1 parameterisation of the same physical pair.  The
  D2 identity contract (ADR 2026-07-26) makes a PARAMETERISATION the unit of
  identity: the two records coexist, each naming its own convention, and a
  case selects one.  Neither is "the" Henry constant for NH3.

  They are not interconvertible by a units factor alone.  Edwards' H is
  MOLAL (kg-atm/mol), referenced to the saturation pressure of water rather
  than 1 atm, and rides an UNSYMMETRIC gamma* from Eq 8 -- so it is only
  meaningful alongside `activityModel edwardsPitzer`.  Mixing it with a
  Davies or Sander calculation silently mismatches the standard state.

  Eq 13:  ln H = B1/T + B2 ln T + B3 T + B4     [kg-atm/mol], T in KELVIN.
  Eq 11 carries it to the system pressure (Krichevsky-Kasarnovsky) using the
  infinite-dilution partial molar volume of Table 2 -- the PARSED vInfinity
  block below (it was quoted here as a comment until 2026-08-23, which is a
  field the engine cannot see; one home now, and it is the one that is read).
  MAGNITUDE CROSS-CHECK (2026-08-04), because a units or temperature-scale
  error here would be silent and catastrophic.  Evaluating Eq 13 at 25 degC
  gives H = 0.0164 kg-atm/mol; converting to a mole-fraction basis through
  x ~ m*M_w gives 9.24e4 Pa, against 9.9e4 Pa in the independently curated
  Sander-Hxp-v1 record for the same pair -- 7 %, which is what two honest
  curations of one physical quantity look like.  A kelvin/Celsius slip or a
  molal/mole-fraction slip would have shown up as a factor of tens, not
  percent.  The check does NOT make the two records interchangeable; it only
  says this one is on the right rung.
\*-----------------------------------------------------------------------------*/
solute      NH3;
solvent     water;

gasSpecies        NH3;
dissolvedSpecies  NH3;
convention        Edwards-Hkgatm-v1;

model       EdwardsEq13;
parameters
{
    B1  -157.552;
    B2  28.1001;
    B3  -0.049227;
    B4  -149.006;
}

Trange ( 273.15 423.15 );   // 0-150 degC, the paper's stated range

//  Table 2: infinite-dilution partial molar volume, for the Krichevsky-
//  Kasarnovsky pressure correction (Eq 11).  These four points used to sit in
//  this record's HEADER COMMENT, which the parser discards -- a field the
//  engine cannot see is a comment (the 2026-08-05 honesty rule), and the
//  vapour-side consumer needs them as data.
vInfinity
{
    units  "cm3/mol";
    points
    (
        { T 273.15; value 28.7; }
        { T 323.15; value 30.0; }
        { T 373.15; value 33.9; }
        { T 423.15; value 40.4; }
    );
    source "Edwards, Maurer, Newman & Prausnitz, AIChE J. 24(6):966-976 (1978), Table 2";
}

source "Edwards, Maurer, Newman & Prausnitz, AIChE J. 24(6):966-976 (1978), Table 3";
