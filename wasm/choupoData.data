    Trange        (298.15  623.1);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        1.621239e-04;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (-76.739  1.081  -7.458000e-04  1.945000e-07);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, Zabransky RECOMMENDED (provenance.liquidHeatCapacity)
    coefficients  (80.51314186  0.6930534867  -0.000237743436);
    Trange        (302  700);
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (10 ACH + 1 AC + 1 ACCH2), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   6.7178;
    q   4.7800;
}

groups
{
    unifac ( { group ACH; count 10; } { group AC; count 1; } { group ACCH2; count 1; } );
    joback ( { group arCH; count 10; } { group arC; count 2; } { group CH2; count 1; } );
}

