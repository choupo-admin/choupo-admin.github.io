    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (97.344  -642.53  6.215244721  6.1931e-05  -4.6438e-08);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
