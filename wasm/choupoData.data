      provenance { origin "Yang et al., ACS Omega 5 (2020) 19655, Table S3 (CC-BY)"; note "row 40* (Van Krevelen) -- carbonate linker"; } }

    { name OCONH;              MW 59;    Yg 16.108;
      structure "-O-C(=O)-NH-  (urethane)";
      provenance { origin "Yang et al., ACS Omega 5 (2020) 19655, Table S3 (CC-BY)"; note "row 41* (Van Krevelen) -- urethane linker"; } }

    { name pPhenylene;         MW 76;    Yg 42.182;
      structure "-C6H4-  (p-phenylene)";
      provenance { origin "Yang et al., ACS Omega 5 (2020) 19655, Table S3 (CC-BY)"; note "row 42* (Van Krevelen) -- 1,4-phenylene ring linker"; } }

    { name methylPhenylene;    MW 90;    Yg 43.893;
      structure "-C6H3(CH3)-  (methyl-p-phenylene)";
      provenance { origin "Yang et al., ACS Omega 5 (2020) 19655, Table S3 (CC-BY)"; note "row 43* (Van Krevelen) -- toluene-derived phenylene linker"; } }

    { name dimethylPhenylene;  MW 104;   Yg 68.975;
      structure "-C6H2(CH3)2-  (2,6-dimethyl-p-phenylene)";
      provenance { origin "Yang et al., ACS Omega 5 (2020) 19655, Table S3 (CC-BY)"; note "row 44* (Van Krevelen) -- xylylene linker (PPO repeat ring)"; } }

    { name cyclohexylene;      MW 82;    Yg 36.274;
      structure "-C6H10-  (1,4-cyclohexylene)";
      provenance { origin "Yang et al., ACS Omega 5 (2020) 19655, Table S3 (CC-BY)"; note "row 45* (Van Krevelen) -- saturated cyclohexane ring linker"; } }

    { name naphthylene;        MW 126;   Yg 111.805;
      structure "-C10H6-  (2,6-naphthylene)";
      provenance { origin "Yang et al., ACS Omega 5 (2020) 19655, Table S3 (CC-BY)"; note "row 46* (Van Krevelen) -- fused naphthalene ring linker"; } }

    { name pyromelliticDiimide; MW 214;  Yg 187.952;
      structure "N,N'-pyromellitic diimide (PMDA imide)";
      provenance { origin "Yang et al., ACS Omega 5 (2020) 19655, Table S3 (CC-BY)"; note "row 47* (Van Krevelen) -- polyimide PMDA diimide ring"; } }

    { name glutarimide;        MW 111;   Yg 44.226;
      structure "N-substituted glutarimide ring";
      provenance { origin "Yang et al., ACS Omega 5 (2020) 19655, Table S3 (CC-BY)"; note "row 48 -- six-membered glutarimide ring"; } }

    { name phthalimide;        MW 145;   Yg 103.180;
      structure "N-substituted phthalimide ring";
      provenance { origin "Yang et al., ACS Omega 5 (2020) 19655, Table S3 (CC-BY)"; note "row 49* (Van Krevelen) -- benzene-fused imide ring"; } }

    { name quinoxaline;        MW 128;   Yg 112.517;
      structure "2,6-quinoxalinediyl ring";
      provenance { origin "Yang et al., ACS Omega 5 (2020) 19655, Table S3 (CC-BY)"; note "row 50 -- fused diazine aromatic ring"; } }

    { name phenylQuinoxaline;  MW 204;   Yg 141.851;
      structure "2-phenyl-quinoxalinediyl ring";
      provenance { origin "Yang et al., ACS Omega 5 (2020) 19655, Table S3 (CC-BY)"; note "row 51 -- phenyl-substituted quinoxaline ring"; } }

    { name benzoxazole;        MW 117;   Yg 88.241;
      structure "2,5-benzoxazolediyl ring";
      provenance { origin "Yang et al., ACS Omega 5 (2020) 19655, Table S3 (CC-BY)"; note "row 52 -- fused benzoxazole aromatic ring"; } }

    { name thiophene;          MW 82;    Yg 35.372;
      structure "2,5-thiophenediyl ring";
      provenance { origin "Yang et al., ACS Omega 5 (2020) 19655, Table S3 (CC-BY)"; note "row 53 -- thiophene ring linker"; } }

    { name dioxane;            MW 86;    Yg 33.723;
      structure "1,3-dioxane-2,5-diyl ring (-O-CH<...>CH-O-)";
      provenance { origin "Yang et al., ACS Omega 5 (2020) 19655, Table S3 (CC-BY)"; note "row 54 -- acetal/dioxane ring linker"; } }

    { name SiCH3CH3;           MW 58;    Yg -1.059;
      structure "-Si(CH3)2-  (dimethylsiloxane Si)";
      provenance { origin "Yang et al., ACS Omega 5 (2020) 19655, Table S3 (CC-BY)"; note "row 55* (Van Krevelen) -- PDMS Si centre (negative contribution)"; } }

    { name SiCH3phenyl;        MW 120;   Yg 21.853;
      structure "-Si(CH3)(phenyl)-";
      provenance { origin "Yang et al., ACS Omega 5 (2020) 19655, Table S3 (CC-BY)"; note "row 56 -- methyl-phenyl siloxane Si centre"; } }

    // SI row 57 -- "-(CH2)n- (oxide)" : the per-CH2 PER-UNIT contribution
    // (FW = n*14, Yg = n*3.412).  Stored as the n=1 unit; use `count` = n.
    { name CH2oxide;           MW 14;    Yg 3.412;
      structure "-(CH2)- in a poly(oxide) backbone  (per CH2, FW=n*14, Yg=n*3.412)";
      provenance { origin "Yang et al., ACS Omega 5 (2020) 19655, Table S3 (CC-BY)"; note "row 57 -- per-CH2 unit of a -(CH2)n-O- oxide backbone; multiply by count=n"; } }

    // SI row 58 -- "backbone in the side chain" : THE Ngb/Ygb term.  FW "depend
    // on atoms" -> carried as 0 here (its mass is already counted by the side-
    // chain groups); only its Yg = 2.771 enters the Tg bracket, once per Nb.
    { name backboneSideChain;  MW 0;     Yg 2.771;
      structure "backbone atom located in a side chain (the Nb/Ygb term)";
      provenance { origin "Yang et al., ACS Omega 5 (2020) 19655, Table S3 (CC-BY)"; method "Nb*Ygb backbone-in-side-chain term of eq 5"; note "row 58 -- FW 'depend on atoms' (mass counted by the side-chain groups, so MW=0 here); add with count=Nb (0 for common vinyl polymers)"; } }
);
/*--------------------------------*- Choupo -*-----------------------*\
  Solution thermo: SUCCINIC ACID dissolved in liquid WATER (arity-2, the aqueous-solution tier -- the
  molecular-solute sibling of parameters/solution/citricAcid-water.dat, written the same way).

  PAIR data: a heat of solution is defined as `crystal -> species dissolved in WATER`, so it names a
  second species and lives HERE, keyed by the (solute, solvent) pair, never inside succinicAcid.dat.

  The engine reads dHsoln for the dissolved-vs-crystalline enthalpy rung:

      h_aq(T) = Hf_crystal + dHsoln + INT_298^T cp_aq dT'

  The dissolved species is the molecular, non-dissociated acid at infinite dilution: Miller & Smith-Magowan's
  dHf(aq acid) = -912.11 +/- 0.42 kJ/mol (Table 2, p. 1059) is dHf(cr) + dH(soln) to the printed digits, so the pair
  reproduces the aqueous acid the succinate ions are referred to (their hfAq are that value plus the Table 6
  ionisation enthalpies).  The dissociated route is the succinate family (see species/ and chemistry/).

  NOT carried: the aqueous heat capacity `Cp`.  No work in hand prints it for this acid, so the cp_aq rung
  refuses by name when a duty reaches the sensible heat of the solution; the formation-level (298.15 K)
  balance is complete.
\*---------------------------------------------------------------------------*/

solute      succinicAcid;
solvent     water;

// Standard enthalpy of solution, crystal -> aqueous (infinite dilution), 298.15 K: 28.70 kJ/mol, endothermic.
dHsoln      28700 J/mol;
dHsoln_provenance
{
    origin   literature;
    method   "Miller & Smith-Magowan, J. Phys. Chem. Ref. Data 19 (1990) 1049, Table 2, p. 1059, row dsolH (read from a page image): dH(soln) = 28.70 kJ/mol (their source 72VAN/MANb); dHf(cr) -940.81 +/- 0.42 kJ/mol and dHf(aq acid) -912.11 +/- 0.42 kJ/mol from the same table(s).";
}
/*--------------------------------*- Choupo -*-----------------------*\
  Solution thermo: GLYCINE dissolved in liquid WATER (arity-2, the aqueous-solution tier; the molecular-solute sibling of
  parameters/solution/citricAcid-water.dat).

  PAIR data: a heat of solution is defined as `crystal -> species dissolved in WATER`, so it lives HERE, keyed by the (solute,
  solvent) pair, never inside glycine.dat.  h_aq(T) = Hf_crystal + dHsoln + INT_298^T cp_aq dT'.

  The dissolved species is the zwitterion at infinite dilution: Miller & Smith-Magowan's dHf(aq) = -514.36 +/- 0.50 kJ/mol
  (Table 3, p. 1054) is dHf(cr) + dH(soln) to the printed digits, and it is the `hfAq` of the zwitterion species of the
  glycine ladder.  NOT carried: the aqueous heat capacity (no work in hand prints it), so the cp_aq rung refuses by name.
\*---------------------------------------------------------------------------*/

solute      glycine;
solvent     water;

// Standard enthalpy of solution, crystal -> aqueous (infinite dilution), 298.15 K: +14.16 +/- 0.01 kJ/mol, endothermic.
dHsoln      14160 J/mol;
dHsoln_provenance
{
    origin   literature;
    method   "Miller & Smith-Magowan, J. Phys. Chem. Ref. Data 19 (1990) 1049, Table 3, p. 1054, row dH(soln) (+14.16 +/- 0.01 kJ/mol; their source 75SPI/WAD; read from a page image); dHf(cr) -528.52 +/- 0.50 kJ/mol and dHf(aq) -514.36 +/- 0.50 kJ/mol from the same table.";
}
/*--------------------------------*- Choupo -*-----------------------*\
  Solution thermo: TARTARIC ACID dissolved in liquid WATER (arity-2, the
  aqueous-solution tier -- the molecular-solute sibling of the ionic
  electrolyte/ions.dat reference; same rung the sugar plant uses).

  This is PAIR data: a heat of solution is defined as `crystal -> species
  dissolved in WATER`, so it names a second species and lives HERE, keyed by
  the (solute, solvent) pair -- never copied into tartaricAcid.dat, which
  references it BY NAME.  (Data-governance Golden Rule, arity-2.)

  The engine reads dHsoln for the dissolved-vs-crystalline enthalpy rung:

      h_aq(T) = Hf_crystal + dHsoln + INT_298^T cp_aq dT'

  while the crystalline pool keeps the solid rung
      h_solid(T) = Hf_crystal + INT_298^T cp_solid dT'    (from tartaricAcid.dat)

  so a NEUTRAL molecular H2Tart can close an aqueous energy balance WITHOUT an
  ideal-gas/Watson vapour leg (which a decomposing solid cannot supply).  The
  dissociated route is separate: the neutral master and its two conjugate
  bases are model species (species/H2Tart.dat, HTart.dat, Tart.dat) and the
  two dissociations are network records (chemistry/HTart-formation.dat,
  chemistry/Tart-formation.dat).
\*---------------------------------------------------------------------------*/

solute      tartaricAcid;
solvent     water;

// Standard enthalpy of solution: crystalline H2Tart -> aqueous (hypothetical
// non-dissociated, high dilution), 298.15 K.  ENDOTHERMIC (positive):
// dissolving tartaric acid cools the solution.  Derived from ONE study on ONE
// material -- the SAME Kochergina source as tartaricAcid.dat's dHf_298:
//   dHsoln = Hf(H2Tart, aq, nondis) - Hf(H2Tart, cr)
//          = -1295.9 - (-1311.2)  =  +15.3 kJ/mol.
// So the heat of crystallisation emerges as h_solid - h_aq ~ -dHsoln from this
// one sourced number (no second hand-entered dHcryst constant).
dHsoln      15300 J/mol;
dHsoln_provenance
{
    origin   literature;
    method   "Kochergina, Volkov, Krutov & Krutova, Russ. J. Phys. Chem. 80 (2006) 899-903, Table 5: Hf(H2Tart, sln, H2O, hyp. nondis., 298.15 K) = -(1295.9) kJ/mol and Hf(H2Tart, cr) = -(1311.2) kJ/mol (mean of two calorimetric methods) -> dHsoln = +15.3 kJ/mol.  Same study cited in tartaricAcid.dat for dHf_298, so crystal datum and heat of solution come from one material in one work.";
}

// Aqueous (dissolved-solute) molar heat capacity is OMITTED here on purpose:
// with no `Cp` key the engine integrates the cp_aq rung with tartaricAcid.dat's
// liquidHeatCapacity (the dissolved-solute Cp it already carries -- Satoh 1939
// solid Cp as a FLAGGED proxy).  Apelblat & Manzurola, J. Chem. Thermodyn. 2001
// carry the true aqueous apparent molar Cp; add a `Cp` key here from it before
// any Cp-sensitive (wide-T) aqueous duty.
/*--------------------------------*- Choupo -*-----------------------*\
  Solution thermo: L-GLUTAMIC ACID dissolved in liquid WATER (arity-2, the aqueous-solution tier; the molecular-solute sibling of
  parameters/solution/citricAcid-water.dat).

  PAIR data: a heat of solution is defined as `crystal -> species dissolved in WATER`, so it lives HERE, keyed by the (solute,
  solvent) pair, never inside glutamicAcid.dat.  h_aq(T) = Hf_crystal + dHsoln + INT_298^T cp_aq dT'.

  The dissolved species is the zwitterion at infinite dilution: Miller & Smith-Magowan's dHf(aq) = -980.72 +/- 1.27 kJ/mol
  (Table 3, p. 1054) is dHf(cr) + dH(soln) to the printed digits, and it is the `hfAq` of the zwitterion species of the
  glutamicacid ladder.  NOT carried: the aqueous heat capacity (no work in hand prints it), so the cp_aq rung refuses by name.
\*---------------------------------------------------------------------------*/

solute      glutamicAcid;
solvent     water;

// Standard enthalpy of solution, crystal -> aqueous (infinite dilution), 298.15 K: +24.53 +/- 0.10 kJ/mol, endothermic.
dHsoln      24530 J/mol;
dHsoln_provenance
{
    origin   literature;
    method   "Miller & Smith-Magowan, J. Phys. Chem. Ref. Data 19 (1990) 1049, Table 3, p. 1054, row dH(soln) (+24.53 +/- 0.10 kJ/mol; their source 80MAT/AMA; Miller notes it is not clear whether the ionisation on dissolution was corrected for; read from a page image); dHf(cr) -1005.25 +/- 1.26 kJ/mol and dHf(aq) -980.72 +/- 1.27 kJ/mol from the same table.";
}
/*--------------------------------*- Choupo -*-----------------------*\
  Solution properties: SODIUM CHLORIDE dissolved in liquid WATER -- the
  solution's own DENSITY law (DEV.md 4c C402, MB-02: the seawater-strength
  membrane cases price their feed on it instead of the massWithoutVolume
  hypothesis, which overstates a 35 g/kg solution by 1 %).

  WHERE THE NUMBERS COME FROM.  The law is a REGRESSION of the form
  polynomialTSqrtX (rho = b1 + b2 t + b3 t^2, b_j = sum_k c_jk x^(k/2),
  x = mass fraction of water, t in degC) to the model of Laliberte and Cooper
  (J. Chem. Eng. Data 49 (2004) 1141-1151), with NaCl's constants read at the
  page (Table 1, p. 1144: c0 -0.00433, c1 0.06471, c2 1.0166, c3 0.014624,
  c4 3315.6; Eq. 9 p. 1142 for the apparent specific volume, Eq. 6 for the
  mixture, Eq. 8 for Kell's water, which is the model's own water) on a grid
  of 31 temperatures (0-60 degC) x 53 mass fractions (0-0.26), by least squares
  in the relative density (bin/curate/fit_nacl_water_density.py).  Laliberte
  and Cooper's NaCl is valid 0-140 degC, w up to 0.26 (Table 3).

  THE EVIDENCE.  In sample (the model it was regressed to): max 0.32 kg/m3
  (0.03 %), rms 0.09 kg/m3 on the grid.  OUT of sample, against tables read at
  their page: the CRC Handbook of Chemistry and Physics, 82nd ed., p. 8-77,
  NaCl at 20 degC: 3 wt % 1019.6 against 1019.35, 4 wt % 1026.8 against
  1026.54 kg/m3 (-0.02 %); and seawater at S = 35 (CRC p. 14-12, PDF p. 1638):
  1023.343 kg/m3 at 25 degC and 1024.763 at 20 degC against 1021.61 and
  1022.94 for NaCl at 35 g/kg -- the seawater is 0.17 % denser because its
  other salts (MgSO4, MgCl2, CaSO4) are denser than their NaCl equivalent;
  the same comparison for the massWithoutVolume reading is +0.96 %.
  Pure water end: 996.99 kg/m3 at 25 degC against Kell's 997.05 (-0.06 %).
  THE HANDBOOK IS A CROSS-CHECK HERE, NEVER A SOURCE (C402, read at the pages
  of the 82nd ed.): the table of p. 8-57 ff. lists two general references
  (Wolf 1966; Sohnel and Novotny 1985) with no attribution per column or per
  solute, and the seawater table of p. 14-12 three (Unesco Tech. Papers in
  Marine Science 36, 1981; Kennish 1989; Poisson 1981), also with none.  No
  primary can therefore be cited `via` it, and no value of it enters this
  record; the comparison above only measures the regression against it.

  The law carries no pressure term.  Licence of the numbers: the constants of
  a published correlation are facts, cited to their paper.
\*---------------------------------------------------------------------------*/

solute      NaCl;
solvent     water;

liquidDensity
{
    returns           solutionDensity;     // kg/m3 of the solution
    form              polynomialTSqrtX;    // rho = b1 + b2 t + b3 t^2, b_j = sum_i c_ji x^(i/2)
    variable          w[water];            // kg water / kg solution
    temperatureOrigin 273.15 K;            // t = T - 273.15 K, in degC

    //  x^0, x^(1/2), x^1, x^(3/2), x^2, x^(5/2)
    b1 ( 1864.88141041  -1301.17063037  5048.41992874  -9787.21878272  6781.04369193  -1605.79464827 );
    b2 ( -2.00496065907  16.7838211445  -70.4329583116  112.251637848  -74.2686894463  17.658124328 );
    b3 ( -0.0087764906382  0.22161272733  -0.49245115392  0.355898286199  -0.0740150545047  -0.00682733397946 );

    //  the regression's grid: 0-60 degC, w[NaCl] 0-0.26 (the model's own limit)
    domain
    (
        { T ( 273.15 333.15 ); w[water] ( 0.74 1 ); }
    );

    pressure          notCarried;

    provenance
    {
        origin        literature;
        citation      "M. Laliberte and W. E. Cooper, J. Chem. Eng. Data 49 (2004) 1141-1151, Eqs. (6), (8), (9) p. 1142 and Table 1 (NaCl) p. 1144, regressed to this form over 0-60 degC and w[NaCl] 0-0.26";
        uncertainty   "in sample (the model): max 0.32 kg/m3 (0.03 %), rms 0.09 kg/m3; out of sample, a handbook table as a cross-check only (the header names it and its pages): NaCl at 20 degC -0.02 %, and seawater S = 35 -0.17 % (other salts)";
        maxDeviation  1.8 kg/m3;           // against the seawater table of the cross-check (header) at 25 degC, the largest comparison
        read          "Laliberte and Cooper 2004 pp. 1142 and 1144 read from the page image (Eq. 8) and the text (Table 1); CRC tables from the text layer of the file";
    }
}
/*--------------------------------*- Choupo -*-----------------------*\
  Solution thermo: CITRIC ACID dissolved in liquid WATER (arity-2, the
  aqueous-solution tier -- the molecular-solute sibling of
  parameters/solution/tartaricAcid-water.dat, written the same way and from the
  same work).

  PAIR data: a heat of solution is defined as `crystal -> species dissolved in
  WATER`, so it names a second species and lives HERE, keyed by the (solute,
  solvent) pair, never inside citricAcid.dat (data-governance golden rule,
  arity-2).

  The engine reads dHsoln for the dissolved-vs-crystalline enthalpy rung:

      h_aq(T) = Hf_crystal + dHsoln + INT_298^T cp_aq dT'

  The dissolved species is the HYPOTHETICAL non-dissociated H3Cit (Kochergina's
  own reference state, Table 4 row "H3Cit (sln, H2O, hyp. nondis)"): at the
  concentrations a food or wine stream carries, the three dissociation steps
  move the enthalpy by tens of J/mol, not kJ/mol (Kochergina p. 900: the second
  to fourth terms of eq. (8) sum to < 0.03 kJ/mol at the dilutions studied), so
  the neutral rung is the right first approximation and is stated as such.  The
  dissociated route is the citrate family (species/H3Cit, H2Cit, HCit, Cit;
  chemistry/*Cit-formation), see docs/design/organic-acids-in-the-catalogue.md.

  NOT carried: the aqueous heat capacity `Cp`.  With no `Cp` key the engine would
  integrate the cp_aq rung with the component's liquidHeatCapacity -- which
  citricAcid.dat does not carry, because no work in hand prints it.  The rung
  therefore refuses by name when a duty reaches the sensible heat of a citric
  solution; the formation-level (298.15 K) balance is complete.
\*---------------------------------------------------------------------------*/

solute      citricAcid;
solvent     water;

// Standard enthalpy of solution: crystalline H3Cit -> aqueous (hypothetical
// non-dissociated, high dilution), 298.15 K.  ENDOTHERMIC (positive): dissolving
// citric acid cools the solution.  From ONE study on ONE material:
//   dHsoln = Hf(H3Cit, sln, hyp. nondis.) - Hf(H3Cit, cr)
//          = -1534.3 - (-1551.7)  =  +17.4 kJ/mol
// (Kochergina et al. 2006, Table 4).  The measured heats of solution at finite
// dilution, Table 2, run 18.8 kJ/mol (n = 9500 H2O per acid) to 17.4 (n = 900);
// the recommended hypothetical-state value is the extrapolation of eq. (8).
dHsoln      17400 J/mol;
dHsoln_provenance
{
    origin   literature;
    method   "Kochergina, Volkov, Krutov & Krutova, Russ. J. Phys. Chem. 80 (2006) 899-903, Table 4: Hf(H3Cit, sln, H2O, hyp. nondis., 298.15 K) = -(1534.3) kJ/mol and Hf(H3Cit, cr) = -(1551.7) +/- 1.3 kJ/mol (weighted mean of two calorimetric procedures) -> dHsoln = +17.4 kJ/mol.  Same study cited in citricAcid.dat for dHf_298, so crystal datum and heat of solution come from one material in one work.";
}
/*--------------------------------*- Choupo -*-----------------------*\
  Solution thermo: SUCROSE dissolved in liquid WATER (arity-2, the
  aqueous-solution tier -- the molecular-solute sibling of the ionic
  electrolyte/ions.dat reference).

  This is PAIR data: a heat of solution is defined as `crystal -> species
  dissolved in WATER`, so its definition names a second species and it lives
  HERE, keyed by the (solute, solvent) pair -- never copied into sucrose.dat,
  which references it BY NAME.  (Data-governance Golden Rule, arity-2.)

  The engine reads dHsoln for the dissolved-vs-crystalline enthalpy rung:

      h_aq(T) = Hf_crystal + dHsoln + INT_298^T cp_aq dT'

  while the crystalline pool keeps the solid rung
      h_solid(T) = Hf_crystal + INT_298^T cp_solid dT'    (from sucrose.dat)

  so the heat of crystallisation EMERGES as h_solid - h_aq ~ -dHsoln from
  this ONE sourced number (no second hand-entered dHcryst constant).
\*---------------------------------------------------------------------------*/

solute      sucrose;
solvent     water;

// Standard enthalpy of solution: crystalline sucrose -> aqueous, high
// dilution, 298.15 K.  ENDOTHERMIC (positive): dissolving sugar cools the
// solution.  Literature scatters 5.4..6.0 kJ/mol; the spread is the
// final-molality endpoint (sucrose's last-stage relative apparent molar
// enthalpy L_phi is non-negligible), NOT measurement noise -- this is the
// high-dilution standard value.
dHsoln      5400 J/mol;
dHsoln_provenance
{
    origin   literature;
    method   "Putnam & Kilday, J. Research NBS 91(4) (1986) 219-222 -- the SAME calorimetric study (NBS, public domain) cited in sucrose.dat for solidHeatCapacity 425.5 J/mol/K, so the crystal Cp and the heat of solution come from one study on one material.  Corroboration (secondary): Gucker, Pickard & Planck, JACS 61 (1939) 459; Goldberg & Tewari, J. Phys. Chem. Ref. Data 18 (1989) 809.";
}

// Aqueous (dissolved-solute) molar heat capacity.  Equal to sucrose's
// liquidHeatCapacity (630 J/mol/K, Honig-tuned to reproduce the sugar-
// industry mixture Cp(x) = 4.19 - 2.35 x kJ/kg/K) -- the SAME number the
// evaporator/crystalliser already integrate for the dissolved solute, named
// here so the aqueous rung is self-contained.
Cp          630;            // J/(mol.K)  -- raw SI (the unit suffix `J/(mol.K)`
                            // carries a `(` the dict tokenizer reads as a list,
                            // so molar-heat-capacity values are written raw,
                            // unit in this comment -- matches ions.dat cpAq and
                            // every component solid/liquid Cp coefficient.
Cp_provenance
{
    origin   literature;
    method   "= sucrose liquidHeatCapacity (Honig sugar-industry correlation; Coulson & Richardson 6th ed. Ex. 14.4).  cp_aq for the dissolved solute on the aqueous rung.";
}

// Validity: high-dilution standard value at 298 K near 1 atm.  T-dependence
// of dHsoln is NOT calibrated here (the heat of crystallisation reconciled
// from this value is taken constant over the stable-crystal window).
Trange      ( 280  330 );
/*--------------------------------*- Choupo -*-----------------------*\
  Solution thermo: L-ALANINE dissolved in liquid WATER (arity-2, the aqueous-solution tier; the molecular-solute sibling of
  parameters/solution/citricAcid-water.dat).

  PAIR data: a heat of solution is defined as `crystal -> species dissolved in WATER`, so it lives HERE, keyed by the (solute,
  solvent) pair, never inside alanine.dat.  h_aq(T) = Hf_crystal + dHsoln + INT_298^T cp_aq dT'.

  The dissolved species is the zwitterion at infinite dilution: Miller & Smith-Magowan's dHf(aq) = -553.75 +/- 0.63 kJ/mol
  (Table 3, p. 1054) is dHf(cr) + dH(soln) to the printed digits, and it is the `hfAq` of the zwitterion species of the
  alanine ladder.  NOT carried: the aqueous heat capacity (no work in hand prints it), so the cp_aq rung refuses by name.
\*---------------------------------------------------------------------------*/

solute      alanine;
solvent     water;

// Standard enthalpy of solution, crystal -> aqueous (infinite dilution), 298.15 K: +7.49 +/- 0.03 kJ/mol, endothermic.
dHsoln      7490 J/mol;
dHsoln_provenance
{
    origin   literature;
    method   "Miller & Smith-Magowan, J. Phys. Chem. Ref. Data 19 (1990) 1049, Table 3, p. 1054, row dH(soln) (+7.49 +/- 0.03 kJ/mol; their source 82ABA/SHE; read from a page image); dHf(cr) -561.24 +/- 0.63 kJ/mol and dHf(aq) -553.75 +/- 0.63 kJ/mol from the same table.";
}
/*--------------------------------*- Choupo -*-----------------------*\
  Solution thermo: FUMARIC ACID dissolved in liquid WATER (arity-2, the aqueous-solution tier -- the
  molecular-solute sibling of parameters/solution/citricAcid-water.dat, written the same way).

  PAIR data: a heat of solution is defined as `crystal -> species dissolved in WATER`, so it names a
  second species and lives HERE, keyed by the (solute, solvent) pair, never inside fumaricAcid.dat.

  The engine reads dHsoln for the dissolved-vs-crystalline enthalpy rung:

      h_aq(T) = Hf_crystal + dHsoln + INT_298^T cp_aq dT'

  The dissolved species is the molecular, non-dissociated acid at infinite dilution: Miller & Smith-Magowan's
  dHf(aq acid) = -775.18 +/- 0.80 kJ/mol (Table 2, p. 1059) is dHf(cr) + dH(soln) to the printed digits, so the pair
  reproduces the aqueous acid the fumarate ions are referred to (their hfAq are that value plus the Table 6
  ionisation enthalpies).  The dissociated route is the fumarate family (see species/ and chemistry/).

  NOT carried: the aqueous heat capacity `Cp`.  No work in hand prints it for this acid, so the cp_aq rung
  refuses by name when a duty reaches the sensible heat of the solution; the formation-level (298.15 K)
  balance is complete.
\*---------------------------------------------------------------------------*/

solute      fumaricAcid;
solvent     water;

// Standard enthalpy of solution, crystal -> aqueous (infinite dilution), 298.15 K: 35.8 kJ/mol, endothermic.
