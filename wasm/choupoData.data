gasSpecies        R115;
dissolvedSpecies  R115;
convention        Sander-Hxp-v1;

model       vantHoff;
H_ref       1.7729e+10 Pa;
T_ref       298.15 K;
enthalpy    -18921  J/mol;
Trange      ( 273  373 );
