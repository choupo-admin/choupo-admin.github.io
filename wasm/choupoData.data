/*--------------------------------*- Choupo -*-----------------------*\
  Component: Ozone (atmospheric oxidant; also used as a strong industrial oxidiser in cold-flame chemistry)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "O3", appendix D p. 166 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 26 (s_298).  The report's own sources
  for this species: Gurvich,1989 pt1 p101 pt2 p15.
  Critical properties: individual literature values -- primary
  re-citation pending (IST review).
  Re-sourced 2026-11-12 (DEV.md 4c C335) by
  bin/curate/nasa_tp2002_to_choupo.py from the NonCommercial compilation
  this record was first generated from (its old numbers
  are not kept here: they were that compilation's); not yet read back by
  a curator.
\*---------------------------------------------------------------------------*/

name        O3;
formula     O3;
CAS         10028-15-6;

MW          47.9982;       // kg/kmol
tags           ( radical gasPhase combustion );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";
Tc          261.1;         // K
Pc          55.73;         // bar
omega       0.227;      // [-]
Tb          161.5;         // K
HvapTb      12000;      // J/mol
Vliq        3.6e-05;       // m^3/mol
VliqT       161.5;       // K -- the temperature Vliq belongs to: the stored value is a volume at the normal boiling point: batch vliq_datum_temperature (evidence.tsv; the value is unchanged)
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 18740;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]

standardThermochemistry
{
    dHf_298    141800.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 166, entry O3
    s_298      239.010;     // J/(mol·K) -- third-law absolute; Table B1, p. 26
}

vaporPressure
{
    model         Antoine;
    coefficients  (3.7125   466.62   -9.45);
    Trange        (80  161);
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 166, entry O3, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.282314507e+04 5.898216640e+02 -2.547496763e+00 2.690121526e-02 -3.528258340e-05 2.312290922e-08 -6.044893270e-12 );
    high     ( -3.869662480e+07 1.023344994e+05 -8.961551600e+01 3.706144970e-02 -4.137638740e-06 -2.725018591e-10 5.248188110e-14 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 166, entry O3, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 26 prints 141.8 kJ/mol; the report's own sources: Gurvich,1989 pt1 p101 pt2 p15.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 26, entry O3";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 239.010";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 166, entry O3, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
/*--------------------------------*- Choupo -*-----------------------*\
  Component: Sodium nitrate (NaNO3, CAS 7631-99-4)

  A non-volatile, fully dissociating salt (Na+ + NO3-), added for the
  water-treatment membrane path (DEV.md 4c C157/C161/C170): a real water's
  ions each carry their transport data on their own species record
  (species/Na.dat, species/NO3.dat), and a salt
  is how a case FEEDS them -- the DSPM-DE pore, the multi-ionic film and the
  electrodialysis units decompose it through `dissociatesTo`.

  IDENTITY ONLY.  The record carries the name, the formula, the CAS number,
  the molar mass and the ion stoichiometry, and nothing it cannot cite: no
  thermochemistry (a dissolved salt's formation enthalpy is ION-DERIVED,
  never a component-level standardThermochemistry block -- CLAUDE.md 5), no
  solubility, no crystal and no heat capacity: each is ABSENT, never a
  zero, and curating them is a later act.
    MW  84.994 g/mol = 22.99 + 14.007 + 3 x 15.999, the IUPAC abridged standard
        atomic weights (Prohaska et al., Standard atomic weights of the
        elements 2021 (IUPAC Technical Report), Pure Appl. Chem. 94 (2022)
        573-600; the abridged values).
\*---------------------------------------------------------------------------*/

name           NaNO3;
formula        NaNO3;
CAS            7631-99-4;
reviewStatus   interim;        // transcribed and self-checked; not yet read back by a curator

MW             84.994;   // g/mol  (= kg/kmol)
role           nonvolatile;    // a dissolved salt never enters the vapour (K = 0)

// APPARENT COMPONENT view -- the balance/representation map (apparent -> ions).
// The van't Hoff factor is DERIVED from it (Component.cpp), never stored twice.
dissociatesTo  { Na 1; NO3 1; }   // ion stoichiometry (formula-like identity)

liquidViscosity
{
    chemsepEq101
    {
        A     -60.81178541;
        B     6419.234067;
        C     6.905838515;
        D     0;
        E     0;
        Tmin  590.3;
        Tmax  752.1;
    }
}

provenance
{
    MW
    {
        origin        literature;
        method        "summed from the IUPAC 2021 abridged standard atomic weights (Prohaska et al., Pure Appl. Chem. 94 (2022) 573): 22.99 + 14.007 + 3 x 15.999";
    }
    liquidViscosity
    {
        origin        fitted;
        method        "least squares on ln y of ln(mu/Pa.s) = A + B/T + C ln T (chemsepEq101 with D = 0), 3 parameter(s), then the largest relative error minimised; every laboratory the archive holds for the pure liquid at <= 200 kPa; points beyond 15 % after the first stage discarded by name";
        fittedBy      "bin/curate/transport_fit.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4: nobody has reviewed it
        fitGrade      warning;   // DEV.md 4c C336 class B limits 10 / 20 / 30 % on the max relative error
        fitGradeBasis inSample;   // DEV.md 4c C300 rule 1
        fitGradeCap   ( singleLaboratory );   // DEV.md 4c C300 rule 2
        fitGradeMaxRelativeError_pct 3.289963;
        Trange        (590.3 752.1);   // K, the kept points -- outside it the engine announces an extrapolation
        reviewReason  "regressed by a machine from archive-transcribed measurements; not yet read back against the articles";
        reuse         "Choupo's own regression; the measured points belong to the cited articles and are not reproduced in this record or this tree (DEV.md 4c C327)";
        evidence
        (
                { doi "10.1007/s10765-006-0119-1"; articleSha256 "b22277792421a8f546c62ce2b02a9059f75e1d7c4caeed5a3e6f1a8f7b94d350"; pointsKept 14; pointsDropped 0; provenance measured; }
        );
        acceptance
        {
            verdict     accepted;
            studies     1;
            pointsKept  14;
            pointsDropped 0;
            dropped     "none";
            aad_pct     1.659533;
