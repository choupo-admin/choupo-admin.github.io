//  HANSEN solubility-parameter triple (DEV.md 4c C428; a model's fact about
//  the pure liquid, read by `hansenMixture` and the Explorer's solvent lens).
//  Hansen 1967 thesis, Table 2.1 row 62 "Hexane", revised placements:
//  delta_d = 7.24, delta_p = 0.0, delta_h = 0.0 (cal/cm3)^0.5, x sqrt(4.184e6) = 2045.4828.
hansen
{
    dD    14809.3;        // Pa^0.5   = 7.24 (cal/cm3)^0.5, thesis Table 2.1 row 62
    dP    0.0;        // Pa^0.5   = 0.0
    dH    0.0;        // Pa^0.5   = 0.0
