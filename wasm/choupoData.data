/*--------------------------------*- Choupo -*-----------------------*\
  Component: Argon  (Ar, CAS 7440-37-1)

  Monatomic noble gas; ~0.93 % of air by mole.  Inert dilutent in
  high-T combustion experiments (replacing N2 when one wants to remove
  NOx formation) and a common shielding gas in welding / metallurgy.
  Cp_p = 5/2 R is exact for any T (no internal degrees of freedom).
  Sources: constants (Tc/Pc/omega/MW/Tb) cross-checked vs CoolProp 7.2.0
  reference EOS; standardThermochemistry cross-checked vs NASA TM-4513
  (McBride-Gordon-Reno 1993); idealGasHeatCapacity -- individual
  literature value, primary re-citation pending (IST review).
\*---------------------------------------------------------------------------*/

name        Ar;
formula     Ar;
CAS         7440-37-1;

MW          39.948;            // kg/kmol
Tc          150.86;             // K
Pc          48.98;              // bar
omega       -0.002;             // [-]  (essentially zero by IUPAC convention)
Tb          87.30;              // K
HvapTb      6447;               // J/mol
Vliq        2.86e-5;            // m^3/mol
VliqT       87.30;       // K -- the temperature Vliq belongs to: the stored value is a volume at the normal boiling point: batch vliq_datum_temperature (evidence.tsv; the value is unchanged)
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 14138.3;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]

standardThermochemistry
{
    dHf_298    0.0;             // J/mol  -- element in its standard state
    s_298      154.84;          // J/(mol·K)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // Poling 5e App. A (via the MIT-licensed `chemicals` 1.5.2 data
    // distribution; INTERIM pending primary review (Vitor))
    coefficients  (3.74141   304.227   -5.83);
    Trange        (83  94);
}

idealGasHeatCapacity
{
    model         polynomial;
    // Monatomic: Cp = 5/2 R = 20.79 J/(mol·K) independent of T.
    coefficients  (20.79   0.0   0.0   0.0);
    Trange        (250  6000);
}
/*--------------------------------*- Choupo -*-----------------------*\
  Component: tetrahydropyran  (tetrahydropyran; CAS 142-68-7)
  NEW in the catalogue (DEV.md 4c C292, slice 2 of C287, 2026-11-10), built by
  bin/curate/c287_new_components.py from measurements the NIST/TRC ThermoML Archive
  locates (the articles are the sources; their DOIs are in provenance).
  UPGRADED by DEV.md 4c C309 (2026-11-11): Tc and Pc replaced by the IUPAC
  recommended value (critically evaluated measurements; citation in
  provenance) and omega re-derived from them.  Nothing else refitted: Vliq
  is the C292 fit, made with the Joback Tc/Pc, kept as it was.
  MEASURED: Tb.  FITTED: vapour pressure (bin/choupo-curate vp),
  Vliq, liquid Cp.  DERIVED: omega (from the fitted vapour pressure).
  ESTIMATED (Joback): ideal-gas Cp, dHf_298; s_298 derived from Joback's
  dHf and dGf.  No measured series is reproduced here.
  reviewStatus autoPromoted, humanReviewed false: NO human has read it back.
  Psat: fitted by `bin/choupo-curate vp`; its promotion replaced the
  AmbroseWalton block this tool writes (provenance.vaporPressure).
\*---------------------------------------------------------------------------*/

name        tetrahydropyran;
CAS         142-68-7;
formula     C5H10O;
reviewStatus autoPromoted;
humanReviewed false;
